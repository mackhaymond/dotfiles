# ~/.zshenv - sourced for ALL zsh invocations. Keep minimal.

# XDG
export XDG_CONFIG_HOME="$HOME/.config"

# Editor + locale
export EDITOR="nvim"
export LC_ALL=en_US.UTF-8

# pyenv shims on PATH for non-login/non-interactive shells. .zprofile (which
# does the canonical setup) is login-only - scripts, `zsh -c`, IDE terminals,
# and non-login interactive shells would otherwise resolve `python3` to system
# Python. Variable-based: $PYENV_ROOT/shims is pyenv's stable layout (since
# 2012). Idempotent with .zprofile (typeset -U in .zprofile dedups).
export PYENV_ROOT="${PYENV_ROOT:-$HOME/.pyenv}"
[[ -d "$PYENV_ROOT/shims" ]] && export PATH="$PYENV_ROOT/shims:$PATH"

# 1Password service-account token: never exported. It used to be, from the
# Keychain into every zsh, which put it in every agent pty, every Claude
# process and every MCP server started from a terminal (removed 2026-10-14).
# Its only consumer is chezmoi's op:// templating, which now gets it per call
# from the `chezmoi` wrapper and the drift check in .zshrc (human shells only).
# The unset drops a copy inherited from a parent started before the change.
# Keychain entry: `security add-generic-password -s op-service-account-token`.
unset OP_SERVICE_ACCOUNT_TOKEN
# Agent shells never reach 1Password through the desktop app either. With CLI
# integration on and the app unlocked, a bare `op` in an agent pty reached
# Mack's whole account, Personal vault included, with no prompt (verified
# 2026-10-14). Markers: AGENT_PTY (tmux-pty-mcp), AGENT_SHELL (set in Codex's
# shell_environment_policy), OPENCODE / OPENCODE_TERMINAL (OpenCode),
# CLAUDECODE (Claude Code's own Bash and `!` commands). Keep this list in sync
# with .chezmoiignore.
if [[ -n "$AGENT_PTY$AGENT_SHELL$OPENCODE$OPENCODE_TERMINAL$CLAUDECODE" ]]; then
  export OP_BIOMETRIC_UNLOCK_ENABLED=false
fi

# OpenCode beta background subagents
export OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS=1

# Secrets (chmod 600, gitignored)
[[ -r "$HOME/.zshenv.private" ]] && source "$HOME/.zshenv.private"

# Keep ANTHROPIC_API_KEY out of interactive shells. Anything started from a
# terminal inherits this env, and an inherited key silently flips Claude Code
# from the subscription to pay-per-token API billing. Non-interactive shells
# (scripts, `zsh -c`, cron, LaunchAgents) keep it — they call the API directly.
# Unset rather than guarding the export in .zshenv.private, so the encrypted
# secrets file stays a plain list of secrets.
[[ -o interactive ]] && unset ANTHROPIC_API_KEY
