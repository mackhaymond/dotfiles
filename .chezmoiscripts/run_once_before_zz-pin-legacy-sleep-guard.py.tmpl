#!/usr/bin/python3
"""Pin the previous legacy runtime before chezmoi overwrites its source."""
{{ if eq .chezmoi.os "darwin" -}}
import ctypes as C
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import plistlib
import subprocess
import tempfile

guard_home = Path({{ .chezmoi.homeDir | quote }})
guard_plist = guard_home / 'Library/LaunchAgents/com.mackhaymond.claude-sleep-guard.plist'
guard_source = guard_home / '.config/claude-sleep-guard/guard.py'
guard_root = guard_home / '.local/state/claude-sleep-guard'
if guard_plist.exists() and guard_source.exists():
    guard_service = plistlib.loads(guard_plist.read_bytes())
    guard_arguments = guard_service.get('ProgramArguments', [])
    guard_wrapper = str(guard_home / '.local/bin/claude-sleep-guard')
    guard_wrapper_service = guard_arguments == [guard_wrapper, 'daemon']
    guard_already_pinned = (len(guard_arguments) == 3 and guard_arguments[0] == '/usr/bin/python3'
                            and (Path(guard_arguments[1]).parent / '.legacy').exists())
    guard_loaded = subprocess.run(['launchctl', 'print', 'gui/%d/com.mackhaymond.claude-sleep-guard' % os.getuid()],
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    guard_loaded_wrapper = guard_loaded.returncode == 0 and guard_wrapper in guard_loaded.stdout
    if guard_wrapper_service or (guard_already_pinned and guard_loaded_wrapper):
        guard_read_source = guard_source if guard_wrapper_service else Path(guard_arguments[1])
        guard_spec = importlib.util.spec_from_file_location('legacy_sleep_guard', guard_read_source)
        guard_module = importlib.util.module_from_spec(guard_spec)
        guard_spec.loader.exec_module(guard_module)
        guard_power = guard_module.Power()
        guard_power.cf.CFBooleanGetValue.argtypes = [C.c_void_p]
        guard_power.cf.CFBooleanGetValue.restype = C.c_bool
        guard_key = guard_power.cf.CFStringCreateWithCString(None, b'AppleClamshellState', 0x08000100)
        guard_lid = guard_power.io.IORegistryEntryCreateCFProperty(guard_power.domain, guard_key, None, 0)
        try:
            guard_open = bool(guard_lid) and not guard_power.cf.CFBooleanGetValue(guard_lid)
        finally:
            if guard_lid:
                guard_power.cf.CFRelease(guard_lid)
            guard_power.cf.CFRelease(guard_key)
        if not guard_open or not guard_power.full_wake():
            raise RuntimeError('Upgrade the legacy sleep guard during a full wake with the lid open')
        for guard_state in [guard_root / 'state.json', guard_root / 'state.json.backup']:
            if guard_state.exists():
                guard_value = json.loads(guard_state.read_text())
                if not isinstance(guard_value.get('held'), dict) or guard_value['held']:
                    raise RuntimeError('Legacy sleep guard still owns paused processes; recover them before upgrading')
        guard_bytes = guard_read_source.read_bytes()
        guard_version = hashlib.sha256(guard_bytes).hexdigest()
        guard_runtime = guard_root / 'versions' / guard_version
        guard_runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
        guard_fd, guard_temporary = tempfile.mkstemp(dir=guard_runtime)
        with os.fdopen(guard_fd, 'wb') as guard_stream:
            guard_stream.write(guard_bytes)
        os.replace(guard_temporary, guard_runtime / 'guard.py')
        (guard_runtime / '.legacy').write_text('Legacy ps timestamp ownership format\n')
        guard_service['ProgramArguments'] = ['/usr/bin/python3', str(guard_runtime / 'guard.py'), 'daemon']
        guard_fd, guard_temporary = tempfile.mkstemp(dir=guard_plist.parent)
        with os.fdopen(guard_fd, 'wb') as guard_stream:
            guard_stream.write(plistlib.dumps(guard_service))
        os.chmod(guard_temporary, 0o644)
        os.replace(guard_temporary, guard_plist)
        if guard_loaded_wrapper:
            # launchd caches ProgramArguments. Pin the loaded job as well as
            # its plist before the mutable wrapper source is overwritten.
            guard_domain = 'gui/%d' % os.getuid()
            subprocess.run(['launchctl', 'bootout', guard_domain + '/com.mackhaymond.claude-sleep-guard'], check=True)
            subprocess.run(['launchctl', 'bootstrap', guard_domain, str(guard_plist)], check=True)
        print('Pinned the previous legacy sleep guard runtime for safe rollback')
{{ end -}}
