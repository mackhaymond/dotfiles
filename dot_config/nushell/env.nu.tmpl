# ~/.config/nushell/env.nu — environment for the nu data tab.
#
# This shell is NOT the login shell. $SHELL stays /bin/zsh, which is the whole
# point: fzf's --with-shell, nvim's &shell, tmux's default-shell, and Claude
# Code's shell snapshots all keep resolving to zsh. Nothing outside this tab
# changes. Launch with CTRL+CMD+T (WezTerm) -> `prefix N` (tmux).
#
# Scope is deliberately narrow. This tab exists for structured-data work —
# yabai/JSON introspection, config surgery, API poking — not for language
# toolchains. nvm / pyenv / conda / sdkman / opam are all absent on purpose:
# nu cannot source POSIX shell script into the live shell (no `eval`, and
# `source` is a parse-time keyword), so those integrations are zsh-only by
# construction. Need them? Type `zsh`.
#
# LOAD ORDER MATTERS. nu parses a file completely before evaluating any of it,
# so a `source` of a file that does not yet exist is a *parse* error, not a
# runtime one. Generating a cache and sourcing it in the same file is therefore
# impossible. env.nu is a separate parse/eval unit that runs first, so caches
# generated here exist by the time config.nu is parsed. Verified on a cold
# cache. Do not move the cache-init calls into config.nu.

# ── Tab marker ────────────────────────────────────────────────────────────
# Read by starship.toml's [env_var.NU_TAB] block, which renders the prompt
# marker. Same pattern as STARSHIP_CHEZMOI_DRIFT / STARSHIP_JOBS_* in .zshrc,
# so there is one starship config, not two.
$env.NU_TAB = "nu"

# zsh-only prompt state. STARSHIP_CHEZMOI_DRIFT* and STARSHIP_JOBS_* are
# `export`ed by ~/.zshrc precmd hooks, so `nu` typed at a zsh prompt inherits
# them; nu runs no precmd, so starship would render a drift glyph or a job
# count frozen at launch time — stale-and-confident, the one thing the zsh
# side's atomic publish exists to prevent. Drop them so this prompt is honestly
# silent. (`prefix N` from tmux starts clean; this covers the nested launch.)
# Setting them to "" is NOT enough: a set-but-empty var still renders the
# module's bare prefix.
# Verified: STARSHIP_CHEZMOI_DRIFT='*' nu -c 'echo $env.STARSHIP_CHEZMOI_DRIFT?'
# prints `*` without this, nothing with it.
for v in [
    STARSHIP_CHEZMOI_DRIFT
    STARSHIP_CHEZMOI_DRIFT_LIVE
    STARSHIP_CHEZMOI_DRIFT_UNCOMMITTED
    STARSHIP_CHEZMOI_DRIFT_SYNC
    STARSHIP_CHEZMOI_DRIFT_STALE
    STARSHIP_JOBS_STOPPED
    STARSHIP_JOBS_RUNNING
] { hide-env --ignore-errors $v }

# ── PATH ──────────────────────────────────────────────────────────────────
# tmux.conf sets a curated baseline PATH via `set-environment -g` for every
# pane it spawns. zsh panes then rebuild the full 45-entry PATH from .zprofile
# — but a nu pane never runs .zprofile, so it inherits only that short list.
# Verified missing from it: ~/bin, ~/userbin, ~/code/various_scripts (where all
# ~35 yabai scripts live, i.e. the primary workload for this tab), ~/code/go/bin,
# google-cloud-sdk/bin, and node. Rebuild here, mirroring .zprofile's ordering.
#
# ~/.atuin/bin is included because .zshrc gets it from `~/.atuin/bin/env`, a
# POSIX script this shell cannot source.
let home = $nu.home-dir

$env.PATH = (
    $env.PATH
    | prepend [
        $"($home)/bin"
        $"($home)/userbin"
        $"($home)/.local/bin"
        $"($home)/code/various_scripts"
        $"($home)/.atuin/bin"
        $"($home)/.cargo/bin"
        $"($home)/.bun/bin"
        $"($home)/.pyenv/shims"
        $"($home)/.local/share/bob/nvim-bin"
        "{{ .homebrew_prefix }}/opt/node/bin"
        "{{ .homebrew_prefix }}/bin"
        "{{ .homebrew_prefix }}/sbin"
    ]
    | append [
        $"($home)/code/go/bin"
        $"($home)/google-cloud-sdk/bin"
        $"($home)/.nimble/bin"
    ]
    | uniq
    | where {|p| $p | path exists }
)

# ── Env ───────────────────────────────────────────────────────────────────
$env.EDITOR = "nvim"
$env.LC_ALL = "en_US.UTF-8"
$env.XDG_CONFIG_HOME = $"($home)/.config"
$env.BAT_THEME = "Catppuccin-mocha"
$env.GOPATH = $"($home)/code/go"
$env.PYENV_ROOT = $"($home)/.pyenv"
# Silences zoxide's false-positive "configuration issue" doctor warning, same
# rationale as .zshrc — the hook is registered correctly in interactive shells.
$env._ZO_DOCTOR = "0"

# 1Password service-account token: never exported (see .zshenv). chezmoi, its
# only consumer, gets it per call from the Keychain through this wrapper. Agent
# shells (AGENT_PTY) get plain chezmoi, as in zsh, where the agent early-return
# skips the zsh wrapper. `complete` keeps a missing/locked entry from erroring.
hide-env -i OP_SERVICE_ACCOUNT_TOKEN
def --wrapped chezmoi [...rest] {
    if ($env.AGENT_PTY? | is-not-empty) { ^chezmoi ...$rest; return }
    let tok = (do -i {
        ^security find-generic-password -s op-service-account-token -a $env.USER -w
    } | complete)
    if $tok.exit_code == 0 and ($tok.stdout | str trim | is-not-empty) {
        with-env { OP_SERVICE_ACCOUNT_TOKEN: ($tok.stdout | str trim) } { ^chezmoi ...$rest }
    } else {
        ^chezmoi ...$rest
    }
}

# Secrets. ~/.zshenv.private is a POSIX file this shell cannot source, so parse
# the `export KEY=VALUE` lines out of it instead of duplicating the secrets into
# a second file. One source of truth; edits to .zshenv.private apply to both
# shells. Values are unquoted; anything more exotic than KEY=VALUE is skipped.
let private_env = $"($home)/.zshenv.private"
if ($private_env | path exists) {
    let secrets = (
        open $private_env
        | lines
        | where {|l| $l =~ '^\s*export\s+[A-Za-z_][A-Za-z0-9_]*=' }
        | str replace -r '^\s*export\s+' ''
        | parse -r '(?<k>[A-Za-z_][A-Za-z0-9_]*)=(?<v>.*)'
        | reduce -f {} {|it, acc|
            $acc | insert $it.k ($it.v | str trim | str trim -c '"' | str trim -c "'")
        }
    )
    if ($secrets | is-not-empty) { load-env $secrets }
}

# ── Tool init caches ──────────────────────────────────────────────────────
# nu has no `eval`, so the zsh idiom `eval "$(tool init zsh)"` has no direct
# equivalent — the generated script must be written to disk and sourced. This
# mirrors ~/.zsh/_cache_init.zsh, including its invalidation rule: regenerate
# only when the tool binary is newer than the cache, so a package upgrade is
# picked up without paying a fork on every shell start.
#
# A cache file is ALWAYS left in place, even when the tool is missing, because
# config.nu's `source` of it must parse. Missing tool => empty file => no-op.
def cache-init [name: string, bin: string, gen: closure] {
    let cache_dir = $"($nu.home-dir)/.cache/nu"
    mkdir $cache_dir
    let cache = $"($cache_dir)/($name).nu"
    let found = (which $bin)

    if ($found | is-empty) {
        if not ($cache | path exists) { "" | save -f $cache }
        return
    }

    # An EMPTY cache counts as stale, not merely absent-and-fresh. This mirrors
    # zsh's `[[ ! -s "$cache" ]]` test and is load-bearing here: the branch above
    # writes a zero-byte placeholder when a tool is missing (config.nu's `source`
    # must parse), and homebrew bottles carry their BUILD mtime — carapace's
    # binary was 3 weeks old the moment it was installed. Without the size check,
    # `binary newer than cache` is false against a placeholder written today and
    # a tool installed after first launch would never activate.
    # The whole boolean must sit inside ONE paren group. Nu does not continue a
    # line inside a block: a leading `or` on the next line parses as a command
    # named `or` and throws at runtime. Inside `( )` the continuation is fine.
    let bin_path = ($found | get 0.path)
    let stale = if ($cache | path exists) {
        (
            ((ls $cache | get 0.size) == 0B)
            or ((ls -l $bin_path | get 0.modified) > (ls -l $cache | get 0.modified))
        )
    } else {
        true
    }

    if $stale {
        let out = (do -i $gen)
        if ($out | is-empty) { "" | save -f $cache } else { $out | save -f $cache }
    }
}

cache-init "starship" "starship" { ^starship init nu }
cache-init "zoxide"   "zoxide"   { ^zoxide init nushell --cmd cd }
cache-init "atuin"    "atuin"    { ^atuin init nu }
# carapace supplies external-command completion (~1090 specs incl. gh, brew,
# gcloud, git). Optional: without it nu still completes its own commands.
# NOTE the shell name is "nushell", not "nu" — carapace exits 0 and prints its
# "expected one of ..." complaint to stderr on an unknown shell, so a wrong name
# here fails silently into a zero-byte cache that looks like a clean no-op.
cache-init "carapace" "carapace" { ^carapace _carapace nushell }
