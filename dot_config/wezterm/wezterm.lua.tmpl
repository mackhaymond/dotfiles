local wezterm = require 'wezterm'

local config = {}

if wezterm.config_builder then
    config = wezterm.config_builder()
end

-- WezTerm is a NORMAL tiled window (never fullscreen). yabai's `space=terminal`
-- rule + the window_created hook place it on the "terminal" space, which
-- yabai_reorder_spaces.sh keeps at canonical index 1, where it tiles as the
-- single stack window. It is intentionally NOT fullscreenable: the WM's hyper+fn+m
-- (yabai's native-fullscreen toggle) no-ops on WezTerm because the borderless
-- RESIZE decoration (no title bar) has no macOS native-fullscreen capability, and
-- native_macos_fullscreen_mode is OFF (below) so WezTerm's own toggle can't enter a
-- fullscreen Space either. We also no longer auto-fullscreen on startup (previously
-- a gui-startup toggle_fullscreen here).

config.color_scheme = "catppuccin-mocha"

config.enable_tab_bar = false
config.enable_kitty_graphics = true
-- RESIZE (no TITLE) keeps the borderless look but reports the window as
-- resizable to the OS, so yabai can size WezTerm to fill whatever display its
-- space is on. "NONE" makes the window non-resizable and yabai can't manage it.
-- Square corners need OpenGL below; WebGPU currently initializes with the
-- wrong scale when MACOS_FORCE_SQUARE_CORNERS is present at startup.
config.window_decorations = "RESIZE|MACOS_FORCE_SQUARE_CORNERS"

config.font = wezterm.font_with_fallback({
    "JetBrains Mono",
    "MesloLGS NF",
})
config.font_size = 12

config.window_padding = {
    left = 0,
    right = 0,
    top = 0,
    bottom = 0,
}

-- The window height is rarely an exact multiple of the cell height, so a few
-- leftover pixels always land somewhere. Anchoring content to the bottom parks
-- them above the first row (invisible against the background) instead of under
-- the tmux status line, where they read as a gap at the edge of the screen.
config.window_content_alignment = {
    horizontal = "Left",
    vertical = "Bottom",
}

config.default_prog = { "{{ .homebrew_prefix }}/bin/tmux", "new-session", "-A", "-s", "main" }

-- WezTerm is intentionally NOT fullscreenable -- it lives as a normal tiled window
-- on the "terminal" space. `false` removes WezTerm's macOS-native-fullscreen
-- capability entirely, so it can never roam into its own fullscreen Space. (The
-- WM's hyper+fn+m toggle already no-ops on the borderless RESIZE window, since a
-- title-bar-less window has no macOS native-fullscreen action; this makes the
-- intent explicit in config rather than relying on that decoration side effect.)
-- extend_behind_notch only matters under native fullscreen, so it is moot here;
-- kept harmless in case the mode is ever re-enabled.
config.native_macos_fullscreen_mode = false
config.macos_fullscreen_extend_behind_notch = true

config.window_close_confirmation = 'NeverPrompt'

config.scrollback_lines = 0

-- ── Performance ────────────────────────────────────────────────────────
config.front_end = "OpenGL"           -- avoids WebGPU square-corner scaling bug
config.max_fps = 60                   -- battery: 120Hz scrollback redraw is not worth it
config.animation_fps = 1              -- minimize animation CPU
config.cursor_blink_rate = 0          -- disable blink entirely
config.use_ime = false                -- skip IME event loop (English only)

-- ── Annoyance fixes ────────────────────────────────────────────────────
config.audible_bell = "Disabled"
config.adjust_window_size_when_changing_font_size = false
config.check_for_updates = false      -- brew handles wezterm@nightly updates

-- ── CMD+Q guard ────────────────────────────────────────────────────────
-- CMD+Q is a WezTerm default key assignment (QuitApplication), so binding it
-- here intercepts it before the app quits. It now takes QUIT_PRESSES presses in
-- quick succession: any gap longer than QUIT_RESET_SECS resets the count to
-- zero. State lives in wezterm.GLOBAL so it survives config reloads. This only
-- guards the KEY -- the Dock/menu "Quit WezTerm" item still quits at once --
-- and it says nothing about the tmux server this window attaches to, which
-- keeps running either way.
local QUIT_PRESSES = 5
local QUIT_RESET_SECS = 1.5

local quit_guard = wezterm.action_callback(function(window, pane)
    local count = (wezterm.GLOBAL.quit_presses or 0) + 1

    if count >= QUIT_PRESSES then
        wezterm.GLOBAL.quit_presses = 0
        window:perform_action(wezterm.action.QuitApplication, pane)
        return
    end

    wezterm.GLOBAL.quit_presses = count
    -- Each press invalidates the pending reset by bumping the token, so the
    -- countdown runs from the LAST press rather than the first.
    local token = (wezterm.GLOBAL.quit_token or 0) + 1
    wezterm.GLOBAL.quit_token = token
    wezterm.time.call_after(QUIT_RESET_SECS, function()
        if wezterm.GLOBAL.quit_token == token then
            wezterm.GLOBAL.quit_presses = 0
        end
    end)

    wezterm.log_info(
        ("CMD+Q ignored: %d of %d presses"):format(count, QUIT_PRESSES))
end)

config.keys = {
    { key = "q", mods = "CMD", action = quit_guard },
    { key = "q", mods = "CMD|SHIFT", action = quit_guard },

    {
        key = "t",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "c" }
        }
    },

    {
        key = "T",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "t", mods = "CTRL" },
        }
    },

    -- The tab keys form a matrix: T is a plain shell, R is claude; no modifier
    -- opens after the current tab in the same cwd, SHIFT opens at the end in
    -- $HOME, OPT replaces the current tab in place.
    --
    --            plain shell      claude
    --   new      CMD+T            CMD+R
    --   at end   CMD+SHIFT+T      CMD+SHIFT+R
    --   replace  CMD+OPT+T        CMD+OPT+R
    --
    -- The claude half sends `prefix k` / `prefix K` / `prefix C-k` (see
    -- tmux.conf). Those tabs are a real zsh with claude started from .zshrc via
    -- ZSH_AUTOSTART, so quitting claude leaves you at a zsh prompt in that tab
    -- rather than closing it.
    --
    -- CMD+R shadows WezTerm's stock ReloadConfiguration. Nothing is lost:
    -- automatically_reload_config is on by default, so saving this file already
    -- reloads it.
    {
        key = "r",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "k" },
        }
    },

    {
        key = "R",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "K", mods = "SHIFT" },
        }
    },

    -- CMD+OPT+T: replace the current tab with a fresh shell, same cwd.
    -- Sends `prefix R` to tmux (see `bind R` in tmux.conf).
    {
        key = "t",
        mods = "CMD|ALT",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "R", mods = "SHIFT" },
        }
    },

    -- CMD+OPT+R: replace the current tab with a claude tab, same cwd.
    -- Sends `prefix C-k` to tmux (see `bind C-k` in tmux.conf).
    {
        key = "r",
        mods = "CMD|ALT",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "k", mods = "CTRL" },
        }
    },


    {
        key = "w",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "x" },
        },
    },

    -- CMD+Z: reopen the most recently closed tab (and resume the claude /
    -- codex / opencode session that was in it). Sends `prefix X`; CMD+W is
    -- what records a close — see closed-tabs.sh.
    {
        key = "z",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "X", mods = "SHIFT" },
        },
    },

    {
        key = "W",
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "l", mods = "CTRL" },
        }
    },

    -- CTRL+CMD+T: new tab running nushell instead of the login shell.
    -- Sends `prefix N` to tmux (see `bind N` in tmux.conf). This does NOT
    -- change $SHELL — zsh stays the login shell, so fzf, nvim's &shell and
    -- tmux's default-shell are unaffected. The nu tab is for structured-data
    -- work (JSON/yabai introspection, config surgery); see
    -- ~/.config/nushell/config.nu.
    {
        key = "t",
        mods = "CTRL|CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = "N", mods = "SHIFT" },
        }
    },

    -- No quick-select runes at the WezTerm layer: tmux-thumbs owns that
    -- (prefix+Space / prefix+C-Space in tmux.conf). It reads the pane buffer,
    -- so it handles URLs that wrap at a narrow pane edge and the full tmux
    -- scrollback, both of which WezTerm's row-based QuickSelect could not.
    -- The stock CTRL+SHIFT+Space QuickSelect is turned off so there is one
    -- rune mode, not two that look alike and behave differently. The default
    -- is registered against the PHYSICAL Space key, so `phys:Space` is what
    -- actually shadows it -- a plain "Space" would add an unrelated mapped-key
    -- entry and leave the original live. Verify with `wezterm show-keys`.
    {
        key = "phys:Space",
        mods = "CTRL|SHIFT",
        action = wezterm.action.DisableDefaultAssignment,
    },

}

for i = 1, 9 do
    table.insert(config.keys, {
        key = tostring(i),
        mods = "CMD",
        action = wezterm.action.Multiple {
            wezterm.action.SendKey { key = "s", mods = "CTRL" },
            wezterm.action.SendKey { key = tostring(i) }
        }
    })
end

return config
