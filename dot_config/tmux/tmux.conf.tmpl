# Baseline PATH for every process tmux spawns (panes, popups, run-shell,
# and anything those launch in turn — including non-shell processes like
# opencode that exec children directly). Login-shell zsh further extends
# this via .zprofile, but non-shell child processes only see what's here.
# Keep this list aligned with the must-have tool dirs from .zprofile.
set-environment -g PATH "$HOME/.local/share/bob/nvim-bin:$HOME/.pyenv/shims:$HOME/.cargo/bin:$HOME/.bun/bin:$HOME/.local/bin:{{ .homebrew_prefix }}/bin:{{ .homebrew_prefix }}/sbin:/usr/bin:/bin:/usr/sbin:/sbin"

setw -g mode-keys vi

unbind r
bind r source-file ~/.config/tmux/tmux.conf

unbind C-b
set -g prefix C-s
set -g mouse on

set -g default-terminal "tmux-256color"
set-option -g terminal-overrides "linux*:AX@,xterm-256color:Tc"
set-option -g terminal-features "xterm*:clipboard:ccolour:cstyle:focus:title,screen*:title,rxvt*:ignorefkeys,xterm-256color:RGB:sixel"
set-option -g allow-passthrough all
set-option -g update-environment "DISPLAY KRB5CCNAME MSYSTEM SSH_ASKPASS SSH_AUTH_SOCK SSH_AGENT_PID SSH_CONNECTION WINDOWID XAUTHORITY TERM TERM_PROGRAM TERM_PROGRAM_VERSION"

set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

set -g pane-border-lines heavy

#### end general setup ####


bind '"' split-window -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind c new-window -a -c "#{pane_current_path}"

# CMD+SHIFT+T (wezterm) → new tab at the end of all tabs, starting in $HOME.
bind C-t new-window -a -t '{end}' -c "#{HOME}"

# CMD+OPT+R (wezterm) → recreate current tab in place, same cwd. (Was
# CMD+SHIFT+R, which now opens a claude tab at the end — see `bind K` below.)
bind R new-window -a -c "#{pane_current_path}" \; kill-window -t -

# CMD+R / CMD+SHIFT+R (wezterm) → the claude tabs: `k` mirrors `c` (after the
# current tab, same cwd), `K` mirrors `C-t` (at the end, in $HOME).
#
# claude is NOT the window's command — that would close the tab the moment you
# quit claude. Instead the window runs the normal login shell and ZSH_AUTOSTART
# tells .zshrc to launch claude as a child of the interactive shell, so quitting
# it drops back to a zsh prompt in the same tab. `-e` scopes the variable to
# this window's first process only; .zshrc unsets it before running the command,
# so it never leaks into claude or into `exec zsh`.
bind k new-window -a -c "#{pane_current_path}" -e ZSH_AUTOSTART=claude
bind K new-window -a -t '{end}' -c "#{HOME}" -e ZSH_AUTOSTART=claude

# CTRL+CMD+T (wezterm) → new tab running nushell, same cwd. The data tab:
# JSON/yabai introspection, config surgery, API poking. $SHELL is untouched
# (still zsh), so this changes nothing outside the tab.
#
# No `-n` name is passed on purpose: `automatic-rename` is on with format
# #{pane_current_command}, and the catppuccin window format falls back to #W
# when @agent_summary is unset, so the tab labels itself "nu" for free without
# touching that (space- and quote-sensitive) format expression.
#
# nu exits → the window closes, since nu is the window's command, not a shell
# running under one.
bind N new-window -a -c "#{pane_current_path}" nu

set -g status-position bottom

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'

# ── tmux-thumbs: vimium-style runes over the focused pane ───────────────
# Complements WezTerm's CMD+SHIFT+Y / CMD+SHIFT+U rather than replacing them.
# WezTerm's version labels every pane at once and works inside full-screen
# TUIs, but it scans RENDERED ROWS -- so a URL that wraps at a narrow pane's
# right edge is two unrelated lines to it and only the first half matches, and
# it cannot see history that has scrolled off. thumbs reads the pane buffer
# instead, so it handles wrapped URLs and the full 50k-line scrollback, at the
# cost of only ever seeing the one focused pane.
set -g @plugin 'fcsonline/tmux-thumbs'

# prefix+Space (was next-layout, unused). Lowercase rune copies; UPPERCASE rune
# opens -- the shift goes on the RUNE, not the trigger, which is the only place
# it can go: see the C-Space note below.
set -g @thumbs-key Space
set -g @thumbs-command 'echo -n "{}" | pbcopy && tmux set-buffer -- "{}" && tmux display-message "copied {}"'
set -g @thumbs-upcase-command 'open "{}" && tmux display-message "opened {}"'

# Same palette as WezTerm's quick_select_* colors (catppuccin-mocha): loud
# peach-on-crust rune, quieter surface1 band under the match. The binary reads
# these @thumbs-* options itself, so they apply to the C-Space binding below
# too. `contrast` wraps runes in [ ] for one more visual cue.
set -g @thumbs-hint-bg-color '#fab387'   # peach
set -g @thumbs-hint-fg-color '#11111b'   # crust
set -g @thumbs-bg-color '#45475a'        # surface1
set -g @thumbs-fg-color '#cdd6f4'        # text
set -g @thumbs-contrast 1

# prefix+C-Space: same picker, but ANY rune opens -- for when you already know
# you want to follow a link and would rather not think about case.
#
# This is deliberately NOT S-Space. `extended-keys` is off (tmux's default), so
# the terminal sends 0x20 for both Space and Shift+Space and tmux can never
# dispatch an S-Space binding -- tmux ACCEPTS the bind silently, it just never
# fires. C-Space sends NUL, which is distinguishable with no global key-encoding
# change. Turning `extended-keys on` would make S-Space work but re-encodes keys
# for every app inside tmux, which is not worth it for one binding.
bind-key C-Space run-shell -b "#{HOME}/.config/tmux/plugins/tmux-thumbs/target/release/tmux-thumbs \
    --dir '#{HOME}/.config/tmux/plugins/tmux-thumbs' \
    --command 'open \"{}\"' \
    --upcase-command 'open \"{}\"'"

