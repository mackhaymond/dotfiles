#!/usr/bin/env bash
# abby-delegate: abby's hands, now a shim over agent-spawn (~/.local/bin),
# which any agent can use to start a child agent of any hooked harness. Kept
# one release so abby's prompt keeps working; prefer agent-spawn's ids.
#
#   abby-delegate spawn [--dir DIR] [--model MODEL] [--] PROMPT|-
#       = agent-spawn spawn --harness claude: a claude child in a background
#       tab right after abby's last child. Prints "<pane id> <window id> -"
#       (children get no letter) and then "id: <spawn id>".
#   PANE below is the pane id spawn printed (%123), or a letter; it must be
#   an agent-spawn child (@agent_spawn_id on its window), else refused.
#   abby-delegate wait PANE [--timeout SECONDS]
#       = agent-spawn wait <id>: until that child's turn ends (default 540 s).
#       Prints "state: <status>", "---", then its reply.
#   abby-delegate last PANE        its last reply (agent-spawn result <id>)
#   abby-delegate list             this abby's children (agent-spawn list)
#
# Follow-ups: agent-spawn send <id> MSG. Close: agent-spawn close <id>.

set -u
AS="${AGENT_SPAWN_BIN:-$(dirname "$0")/agent-spawn}"
[ -x "$AS" ] || AS=agent-spawn

die() { printf 'abby-delegate: %s\n' "$*" >&2; exit 1; }

# id_of PANE: the @agent_spawn_id of the live pane PANE (a %id, or an agent
# letter matched against @agent_key). Nothing when there is none.
id_of() {
    local want="$1"
    tmux list-panes -a -F "#{pane_id}"$'\t'"#{@agent_key}"$'\t'"#{@agent_spawn_id}" 2>/dev/null | awk -F'\t' -v w="$want" '
        ($1 == w || ($2 == w && w !~ /^%/)) { print $3; exit }'
}

need_id() {
    local id
    [ -n "${1:-}" ] || die "usage: abby-delegate $2 PANE"
    id="$(id_of "$1")"
    [[ "$id" == s-* ]] || die "$1 is not an agent-spawn child (no @agent_spawn_id); use agent-spawn ids"
    printf '%s' "$id"
}

# fmt: agent-spawn's --json result(s) as the old "state: …\n---\nreply".
fmt() {
    python3 -c '
import json, sys
d = json.load(sys.stdin)
r = d[0] if isinstance(d, list) else d
print("state: %s" % r["status"] + (" (%s)" % r["detail"] if r["status"] not in ("done",) and r.get("detail") else ""))
print("---")
print(r["reply"] if r.get("reply") is not None else "(no reply yet)")'
}

cmd_spawn() {
    local -a args=(spawn --harness claude)
    while [ $# -gt 0 ]; do
        case "$1" in
        --dir|--model) args+=("$1" "${2:-}"); shift 2 ;;
        --) shift; break ;;
        -) break ;;
        -*) die "unknown option $1" ;;
        *) break ;;
        esac
    done
    local out id pane win key rc
    out="$("$AS" "${args[@]}" -- "$@")"
    rc=$?
    [ $rc -eq 0 ] || exit $rc
    read -r id pane win key <<<"$out"
    printf '%s %s %s\nid: %s\n' "$pane" "$win" "${key:--}" "$id"
}

cmd_wait() {
    local pane="" timeout=540 id out rc
    while [ $# -gt 0 ]; do
        case "$1" in
        --timeout) timeout="${2:-540}"; shift 2 ;;
        *) pane="$1"; shift ;;
        esac
    done
    id="$(need_id "$pane" wait)" || exit 1
    out="$("$AS" wait "$id" --timeout "$timeout" --json)"
    rc=$?
    if [ $rc -eq 75 ]; then
        printf 'state: %s (still going after %ss; wait again or read_pane)\n' \
            "$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["status"])' 2>/dev/null || echo running)" "$timeout"
        exit $rc
    fi
    [ -n "$out" ] || exit $rc
    printf '%s' "$out" | fmt
    exit $rc
}

cmd_last() {
    local id out
    id="$(need_id "${1:-}" last)" || exit 1
    out="$("$AS" result "$id" --json)"
    [ -n "$out" ] || exit 1
    printf '%s' "$out" | python3 -c 'import json,sys; r=json.load(sys.stdin); print(r["reply"] if r.get("reply") is not None else "(no reply yet)")'
}

case "${1:-}" in
spawn) shift; cmd_spawn "$@" ;;
wait)  shift; cmd_wait "$@" ;;
last)  shift; cmd_last "$@" ;;
list)  shift; exec "$AS" list "$@" ;;
*) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
