#!/usr/bin/env bash
#
# chezmoi-commit — split pending chezmoi *source* changes into logical commits,
# write a message for each with a fast/cheap model, commit, and push.
#
# AI backend: ai-exec — codex CLI first, then claude CLI (haiku), then copilot,
# each only if the one before fails (or codex is usage-limited).
# Does NOT run `chezmoi re-add` — it only commits what's already changed in the
# chezmoi source repo (edit via `chezmoi edit` or directly, then run this).
# Before any diff is sent to a model the pending changes are scanned with
# gitleaks (same scan as the repo's pre-commit hook); a hit aborts the run.
#
# Usage:
#   chezmoi-commit            # group, commit, and push
#   chezmoi-commit --dry-run  # show the planned commits, change nothing
#   chezmoi-commit --no-push  # commit but don't push
#
# Env overrides:
#   CHEZMOI_COMMIT_CODEX_MODEL   (default: gpt-5.4-mini, run at low reasoning
#                                 effort to keep it fast/cheap)
#   CHEZMOI_COMMIT_CLAUDE_MODEL  (default: haiku; the first fallback)
#
# Requires: chezmoi, jq, gitleaks, ai-exec, and one of codex/claude/copilot.
#
# Exit status:
#   0  every group committed (and pushed unless --no-push), or nothing to do
#   1  a hard failure (missing tool, gitleaks hit, model/validation failure —
#      nothing committed), OR the pre-commit hook rejected at least one group:
#      the other groups ARE committed and pushed, the rejected files are left
#      unstaged, and the summary names them. Don't treat `cmc && …` as "the
#      tree is clean" — check `git status`.
#   2  unknown argument

set -euo pipefail

DRY_RUN=0
PUSH=1
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --no-push) PUSH=0 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $arg" >&2; exit 2 ;;
  esac
done

CLAUDE_MODEL="${CHEZMOI_COMMIT_CLAUDE_MODEL:-haiku}"
CODEX_MODEL="${CHEZMOI_COMMIT_CODEX_MODEL:-gpt-5.4-mini}"

die() { echo "chezmoi-commit: $*" >&2; exit 1; }

command -v chezmoi >/dev/null || die "chezmoi not found"
command -v jq >/dev/null || die "jq not found"

SRC="$(chezmoi source-path)" || die "could not resolve chezmoi source-path"
cd "$SRC" || die "could not cd into $SRC"

# Bail early if the source repo is clean.
if [ -z "$(git status --porcelain)" ]; then
  echo "Nothing to commit in $SRC"
  exit 0
fi

# The authoritative set of changed paths (tracked modifications + untracked),
# NUL-safe. We only ever commit files that appear here. `-uall` expands a new
# directory into its individual files so CHANGED matches what the model is
# shown via `git ls-files --others` (otherwise a group naming those files is
# dropped as "hallucinated" and the dir falls into the catch-all commit).
# A staged rename is emitted by `-z` as "R  <new>\0<orig>\0": keep BOTH halves
# so the deletion of <orig> is committed with the rename, and remember the
# pair so it stays in one commit (RENAME_PAIRS: "<new>\t<orig>" per line).
RENAME_PAIRS=""
mapfile -d '' -t CHANGED < <(git status -z --porcelain -uall | \
  while IFS= read -r -d '' entry; do
    path="${entry:3}"
    printf '%s\0' "$path"
    case "${entry:0:2}" in
      R*|C*) read -r -d '' orig || true; printf '%s\0' "$orig" ;;
    esac
  done)
RENAME_PAIRS="$(git status -z --porcelain -uall | \
  while IFS= read -r -d '' entry; do
    case "${entry:0:2}" in
      R*|C*) read -r -d '' orig || true; printf '%s\t%s\n' "${entry:3}" "$orig" ;;
    esac
  done)"

[ "${#CHANGED[@]}" -gt 0 ] || die "no changed files resolved"

# --- Secret scan BEFORE anything leaves the machine ----------------------------
# The repo's pre-commit hook runs `gitleaks protect --staged`, but that only
# fires at commit time — after the diff below has already been shipped to the
# model. Run the same staged scan first, against a throwaway copy of the index
# so the real index (and whatever the user has staged) is never touched.
command -v gitleaks >/dev/null || die "gitleaks not found (needed to scan changes before they are sent to the model)"
TMP_INDEX="$(mktemp)"
REAL_INDEX="$(git rev-parse --git-path index)"
[ -f "$REAL_INDEX" ] && cp "$REAL_INDEX" "$TMP_INDEX"
# `-A .` rather than the CHANGED list: a rename's old path exists in neither
# the worktree nor the index copy, so a pathspec for it would fail.
GIT_INDEX_FILE="$TMP_INDEX" git add -A -- . || { rm -f "$TMP_INDEX"; die "could not stage changes for the secret scan"; }
if ! GIT_INDEX_FILE="$TMP_INDEX" gitleaks git --staged --verbose --redact --no-banner . ; then
  rm -f "$TMP_INDEX"
  die "gitleaks found a possible secret in the pending changes; nothing was sent to the model and nothing was committed. Fix (or .gitleaksignore) it and re-run."
fi
rm -f "$TMP_INDEX"

# Build the context we hand to the model: porcelain status + a size-capped diff
# (staged + unstaged) + names of untracked files so it can group them too.
CONTEXT="$(
  printf '## git status\n'
  git -c color.ui=never status --short -uall
  printf '\n## diff (tracked changes, truncated)\n'
  git -c color.ui=never diff HEAD -- . | head -c 60000
  printf '\n## untracked files\n'
  git ls-files --others --exclude-standard
)"

read -r -d '' INSTRUCTIONS <<'EOF' || true
You are organizing pending git changes in a chezmoi dotfiles repo into a small
number of LOGICAL commits. A logical commit groups changes that belong to the
same app/feature/intent (e.g. all wezterm tweaks together, all shell aliases
together). Prefer few cohesive commits over many tiny ones.

Return ONLY a JSON object, no prose, no markdown fences, of exactly this shape:
{"groups":[{"message":"<conventional, imperative, <=72 chars>","files":["<path>", ...]}]}

Rules:
- Use the EXACT file paths from the status/untracked lists below.
- Every changed file must appear in exactly one group.
- Do not invent paths. Do not include unchanged files.
- Messages: conventional-commit style when natural (e.g. "feat(wezterm): ...",
  "chore(zsh): ..."), concise, imperative mood, no trailing period.
EOF

PROMPT="$INSTRUCTIONS

# Repository changes
$CONTEXT"

# --- Ask the model for the grouping JSON --------------------------------------

# Strip markdown code fences and isolate the JSON object.
extract_json() {
  sed -e 's/^```[a-zA-Z]*$//' -e 's/^```$//' | \
    awk 'BEGIN{d=0} {for(i=1;i<=length($0);i++){c=substr($0,i,1); if(c=="{")d++; if(d>0)printf "%s",c; if(c=="}"){d--; if(d==0)printf "\n"}}}'
}

GROUPS_JSON=""

# One ai-exec call does the whole fallback chain: codex runs with these args
# verbatim, and when it fails (or is usage-limited) ai-exec retries the same
# task on claude --model $CLAUDE_MODEL, then copilot, translating the schema
# and -o for each. Its stderr (which backend failed, and why) is kept aside
# and shown only if every backend fails.
try_ai_exec() {
  local aiexec
  aiexec="$(command -v ai-exec || echo "$HOME/.local/bin/ai-exec")"
  [ -x "$aiexec" ] || { echo "ai-exec not found" >&2; return 1; }
  local schema last errlog
  schema="$(mktemp)"; last="$(mktemp)"; errlog="$(mktemp)"
  cat >"$schema" <<'JSON'
{
  "type": "object",
  "additionalProperties": false,
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "files"],
        "properties": {
          "message": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
JSON
  # Unset ANTHROPIC_API_KEY so the claude leg authenticates via the OAuth
  # subscription (Pro/Max) instead of billing the API credit balance. The
  # prompt goes on stdin (`-`): the diff can run to 60k+ chars.
  if ! printf '%s' "$PROMPT" | env -u ANTHROPIC_API_KEY "$aiexec" exec \
      -m "$CODEX_MODEL" \
      -c model_reasoning_effort="low" \
      --skip-git-repo-check \
      --output-schema "$schema" \
      -o "$last" \
      --claude-model "$CLAUDE_MODEL" \
      - >/dev/null 2>"$errlog"; then
    tail -n 5 "$errlog" >&2
    rm -f "$schema" "$last" "$errlog"
    return 1
  fi
  local out; out="$(extract_json <"$last")"
  rm -f "$schema" "$last" "$errlog"
  printf '%s' "$out" | jq -e '.groups | type == "array"' >/dev/null 2>&1 || return 1
  GROUPS_JSON="$out"
}

echo "Grouping changes (ai-exec: codex $CODEX_MODEL → claude $CLAUDE_MODEL → copilot)…" >&2
try_ai_exec || die "codex, claude and copilot all failed to produce a grouping"

# --- Validate the grouping against the real changed set -----------------------

# Write the actual changed paths to a temp file for jq membership checks.
CHANGED_FILE="$(mktemp)"
printf '%s\n' "${CHANGED[@]}" >"$CHANGED_FILE"

# Keep only files that genuinely changed (drop hallucinated paths), and
# replace a missing/null/blank message with a safe fallback subject so neither
# a literal "null" nor an empty `-m ""` (which git rejects) reaches `git commit`.
GROUPS_JSON="$(jq --rawfile changed "$CHANGED_FILE" '
  ($changed | rtrimstr("\n") | split("\n")) as $valid
  | {groups: [ .groups[]
      | .files |= map(select(. as $f | $valid | index($f)))
      | .message = ((.message? | select(type == "string"
            and ascii_downcase != "null"
            and gsub("\\s"; "") != "")) // "chore: update dotfiles")
      | select(.files | length > 0) ]}
' <<<"$GROUPS_JSON")" || die "failed to validate grouping JSON"

NGROUPS="$(jq '.groups | length' <<<"$GROUPS_JSON")"
[ "$NGROUPS" -gt 0 ] || die "model returned no usable groups"

# Any changed file the model forgot? Sweep it into a final catch-all commit.
COVERED="$(jq -r '.groups[].files[]' <<<"$GROUPS_JSON" | sort -u)"
MISSING="$(comm -23 <(printf '%s\n' "${CHANGED[@]}" | sort -u) <(printf '%s' "$COVERED"))"
if [ -n "$MISSING" ]; then
  GROUPS_JSON="$(jq --arg msg "chore: commit remaining dotfile changes" \
    --slurpfile m <(printf '%s\n' "$MISSING" | jq -R . | jq -s .) \
    '.groups += [{message: $msg, files: $m[0]}]' <<<"$GROUPS_JSON")"
  NGROUPS=$((NGROUPS + 1))
fi

# Keep each rename's two halves together: the old path always rides in the
# group that holds the new path (wherever the model or the sweep put it).
if [ -n "$RENAME_PAIRS" ]; then
  PAIRS_JSON="$(printf '%s\n' "$RENAME_PAIRS" | jq -R 'split("\t")' | jq -s .)"
  GROUPS_JSON="$(jq --argjson pairs "$PAIRS_JSON" '
    reduce $pairs[] as [$new, $orig] (.;
      .groups |= (map(.files -= [$orig])
        | map(if (.files | index($new)) != null then .files += [$orig] else . end)))
    | .groups |= map(select(.files | length > 0))
  ' <<<"$GROUPS_JSON")" || die "failed to pair renamed files"
  NGROUPS="$(jq '.groups | length' <<<"$GROUPS_JSON")"
fi

# --- Show the plan ------------------------------------------------------------

echo
echo "Planned commits ($NGROUPS):"
jq -r '.groups | to_entries[] | "  \(.key+1). \(.value.message)\n" + (.value.files | map("       - " + .) | join("\n"))' <<<"$GROUPS_JSON"
echo

if [ "$DRY_RUN" -eq 1 ]; then
  echo "(dry run — nothing committed)"
  exit 0
fi

# --- Commit each group --------------------------------------------------------

# Start from a clean stage so each group commits only its own files.
git reset -q

COMMITS=0
FAILED=()
while IFS= read -r grp; do
  msg="$(jq -r '.message' <<<"$grp")"
  mapfile -t files < <(jq -r '.files[]' <<<"$grp")
  [ "${#files[@]}" -gt 0 ] || continue
  git add -- "${files[@]}"
  if git diff --cached --quiet; then
    continue  # nothing actually staged for this group
  fi
  # A pre-commit rejection (e.g. gitleaks) must not abort the whole run under
  # set -e: unstage this group, remember it, and carry on with the rest.
  if ! git commit -q -m "$msg"; then
    git reset -q -- "${files[@]}"
    echo "✗ $msg (rejected by pre-commit; left uncommitted)" >&2
    FAILED+=("$msg")
    continue
  fi
  echo "✓ $msg"
  COMMITS=$((COMMITS + 1))
done < <(jq -c '.groups[]' <<<"$GROUPS_JSON")

if [ "${#FAILED[@]}" -gt 0 ]; then
  echo "Committed $COMMITS of $NGROUPS group(s); ${#FAILED[@]} rejected by pre-commit:" >&2
  printf '  - %s\n' "${FAILED[@]}" >&2
fi

[ "$COMMITS" -gt 0 ] || die "nothing was committed"

# --- Push ---------------------------------------------------------------------

if [ "$PUSH" -eq 1 ]; then
  echo "Pushing $COMMITS commit(s)…"
  git push
  echo "Done."
else
  echo "Committed $COMMITS group(s); skipped push (--no-push)."
fi

# Rejected groups are still pending in the worktree; make that an error exit.
[ "${#FAILED[@]}" -eq 0 ] || exit 1
