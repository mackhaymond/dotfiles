#!/usr/bin/env python3
"""abby: Claude Code on abliteration.ai models, with your normal setup.

Runs `claude` with CLAUDE_CONFIG_DIR=~/.claude-abby, and that one variable
is all that makes it abby: the dir's settings.json carries the gateway
(env block + an apiKeyHelper that reads the keychain), so any path that
re-launches `claude` with the variable set - tmux restore, CMD+Z reopen,
unpark (stash.sh) - comes back on abliteration, not Anthropic.

The dir symlinks every entry of ~/.claude (CLAUDE.md, hooks, plugins,
skills, sessions...) EXCEPT settings.json and .claude.json, which are
private copies rebuilt from the live ones on each launch. So hooks and agent
status work as usual, and /model "set as default", /autocompact and effort
picks stick for abby without writing an abliteration model into the
settings plain `claude` reads.

Conversations are abby's own: projects/ (transcripts) and history.jsonl are
real, so `abby --continue` / `--resume` and up-arrow see only abby sessions
and `claude --continue` never picks one up. Memory stays shared: each
project's memory/ is a link to the one under ~/.claude/projects. Abby
sessions recorded in ~/.claude/projects before the split move over on
launch once their process has exited.

Models (from GET /v1/models, 2026-11-09):
  abliterated-model-large-v2     1M ctx, text only,   $3/$5 per Mtok  (default)
  abliterated-model-large-flash  1M ctx, text+image,  $1/$2           (haiku/background slot)
  abliterated-model-large        1M ctx, text only,   $3/$5
  abliterated-model              256K ctx, text+image, $1/$3
The 1M ones carry Claude Code's "[1m]" suffix (stripped before sending) so
it sizes their window right; CLAUDE_CODE_MAX_CONTEXT_TOKENS covers the 256K
one. Auto-compact defaults to 400K (see AUTO_COMPACT_WINDOW).

Key: keychain item "abliteration-api-key":
  security add-generic-password -U -a "$USER" -s abliteration-api-key -w
One-off model: abby --model abliterated-model
"""
import copy
import hashlib
import json
import os
import plistlib
import shlex
import socket
import subprocess
import sys
import tempfile
import time
import uuid

HOME = os.path.expanduser("~")
SRC = os.path.join(HOME, ".claude")
DST = os.path.join(HOME, ".claude-abby")
PRIVATE = {"settings.json"}  # not symlinked; generated below
USER = os.environ.get("USER") or os.path.basename(HOME)
KEY_CMD = ["security", "find-generic-password", "-a", USER,
           "-s", "abliteration-api-key", "-w"]

MAIN = "abliterated-model-large-v2[1m]"
FAST = "abliterated-model-large-flash[1m]"
AUTO_COMPACT_WINDOW = 400_000  # 1M models: compact at ~400K, not ~1M

UPSTREAM = "https://api.abliteration.ai"
# abby-guard (its own script): a local pass-through that retries the requests
# abliteration's gateway answers with nothing (content swallowed, tokens
# billed). A launchd agent on a fixed port, since settings are shared by every
# abby session; abby installs it and falls back to UPSTREAM if it won't start.
GUARD = os.path.join(HOME, ".local", "bin", "abby-guard")
GUARD_PORT = 8789
GUARD_LABEL = "com.mackhaymond.abby-guard"
GUARD_PLIST = os.path.join(HOME, "Library", "LaunchAgents", GUARD_LABEL + ".plist")

GATEWAY_ENV = {
    "ANTHROPIC_BASE_URL": UPSTREAM,  # or the guard's URL; see main()
    # Aliases used by subagents ("opus"/"sonnet"/"haiku") and background work.
    "ANTHROPIC_DEFAULT_FABLE_MODEL": MAIN,
    "ANTHROPIC_DEFAULT_OPUS_MODEL": MAIN,
    "ANTHROPIC_DEFAULT_SONNET_MODEL": MAIN,
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": FAST,
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144",  # abliterated-model, the one non-1M model
    # GLM-5.3's max output is 128K and thinking counts against it (max effort
    # ran ~18K tokens of thinking on one hard prompt); 128000 is CC's cap.
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    # Auto mode's classifier. CC assumes an unknown model can't turn thinking
    # off, so it sent the classifier no thinking param: GLM then thinks at
    # length, writes "</block>" inside its thinking, trips the stop sequence,
    # and stage 1 never answers (2 calls, ~9s, aborted under load: "auto
    # mode's check had no usable answer"). Marking these models as accepting
    # disabled thinking makes stage 1 one ~2s call with thinking off (on Large
    # v2 that means low effort, hidden trace). Measured through a proxy.
    "CLAUDE_CODE_MODEL_CAPABILITIES": "abliterated-model*=-rejects_disabled_thinking",
    # Z.ai's recommended Claude Code setting for GLM (slow serving at peak).
    "API_TIMEOUT_MS": "3000000",
}
# Notices acknowledged inside abby (its .claude.json is re-copied from the
# live one each launch): carried over so they don't come back every launch.
ACK_SUFFIXES = ("AcknowledgedAt", "Acknowledged", "Noticed", "Dismissed", "DismissedAt")
# "high", not GLM's recommended "max" (2026-11-09): on abliteration, max
# measured ~10x the thinking tokens (it bills by the token) and was the setting
# its gateway swallowed responses at (see abby-guard). /effort max still works
# per session, and a level saved there sticks.
DEFAULT_EFFORT = "high"

FLAGS_FILE = os.path.join(DST, "abby.settings.json")  # passed via --settings
# abby keeps its own, never shares these. projects/ and history.jsonl keep
# its conversations apart from Claude's (see the docstring).
OWN_DIRS = {"backups", "daemon", "projects", "history.jsonl", "themes"}

# ── Look: abby must be unmistakable at a glance ──────────────────────────────
# Neon green where Claude is orange: a custom theme, an ABBY badge on the
# statusline, its own spinner words, and a green-tinted tmux pane background
# while a session runs (SessionStart/SessionEnd hooks below).
ACCENT, ACCENT_SOFT, TINT = "#39ff88", "#a8ffcb", "#0d1f16"
THEME = {
    "name": "Abby",
    "base": "dark",
    "overrides": {
        "claude": ACCENT, "claudeShimmer": ACCENT_SOFT,
        "clawd_body": ACCENT,  # the startup logo
        "rate_limit_fill": ACCENT,
        "promptBorder": ACCENT, "promptBorderShimmer": ACCENT_SOFT,
        "permission": "#ff79c6", "permissionShimmer": "#ffb3e0",
        "suggestion": "#7cf5c4", "remember": "#7cf5c4",
        "briefLabelClaude": ACCENT,
        "userMessageBackground": "#12301f", "userMessageBackgroundHover": "#184029",
        "bashMessageBackgroundColor": "#1a2a12",
        "selectionBg": "#1f4d33",
    },
}
# ABBY badge + abliteration balance, then the usual statusline (its own script).
STATUSLINE = os.path.join(HOME, ".local", "bin", "abby-statusline")
SPINNER_VERBS = ["Abliterating", "Unshackling", "Going off-script", "Unfiltering",
                 "Freewheeling", "Jailbreaking the compiler", "Abby-ing", "Off the leash",
                 "Unmuzzling", "Rule-bending", "Defanging bugs", "Ungating"]
_tmux = "/opt/homebrew/bin/tmux"
TINT_ON = (f'[ -n "$TMUX_PANE" ] && {_tmux} set -p -t "$TMUX_PANE" window-style "bg={TINT}" '
           f'\\; set -p -t "$TMUX_PANE" window-active-style "bg={TINT}" >/dev/null 2>&1; true')
TINT_OFF = (f'[ -n "$TMUX_PANE" ] && {_tmux} set -pu -t "$TMUX_PANE" window-style '
            f'\\; set -pu -t "$TMUX_PANE" window-active-style >/dev/null 2>&1; true')
# GLM sometimes ends a turn right after "Doing X now:" with no tool call; this
# Stop hook nudges it once to make the call (see the script's docstring).
STOP_NUDGE = os.path.join(HOME, ".local", "bin", "abby-stop-nudge")
LOOK_HOOKS = {
    "SessionStart": [{"hooks": [{"type": "command", "command": TINT_ON}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": TINT_OFF}]}],
    "Stop": [{"hooks": [{"type": "command", "command": shlex.quote(STOP_NUDGE)}]}],
}
# Versioned: bump the name when is_abby_transcript's rule changes, so files
# cached as "not abby" under the old rule get looked at again.
MIGRATE_CACHE = os.path.join(DST, ".migrate-cache-v2.json")
MIGRATE_DAYS = 14  # abby predates the split by one day; older can't be abby
SKIP_SUFFIXES = (".lock", ".tmp")  # transient; a link to one would dangle

PICKER = {
    "replaceBuiltInOptions": True,
    "options": [
        {"model": MAIN, "label": "Large v2",
         "description": "GLM-5.3 · 1M ctx · text only · $3/$5 per Mtok · best for coding"},
        {"model": FAST, "label": "Large Flash",
         "description": "1M ctx · images · $1/$2 · fast and cheap"},
        {"model": "abliterated-model-large[1m]", "label": "Large",
         "description": "1M ctx · text only · $3/$5 · previous large"},
        {"model": "abliterated-model", "label": "Base",
         "description": "256K ctx · images · $1/$3"},
    ],
}


def die(msg):
    print(f"abby: {msg}", file=sys.stderr)
    sys.exit(1)


def check_key():
    r = subprocess.run(KEY_CMD, capture_output=True, text=True)
    if not r.stdout.strip():
        die("no abliteration.ai key in the keychain. Add it with:\n"
            '  security add-generic-password -U -a "$USER" -s abliteration-api-key -w')


def load(path, required=False):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        if required:
            die(f"{path} not found")
        return {}
    except json.JSONDecodeError as e:
        if required:  # running without its hooks would lose status/restore
            die(f"can't parse {path} ({e}); try again in a moment")
        print(f"abby: ignoring unreadable {path}: {e}", file=sys.stderr)
        return {}


def write_atomic(path, data):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".abby-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def is_ab(model):
    return isinstance(model, str) and model.startswith("abliterated-model")


def link_tree():
    os.makedirs(DST, exist_ok=True)
    for name in os.listdir(DST):  # drop dangling or no-longer-shared links
        p = os.path.join(DST, name)
        if os.path.islink(p) and (not os.path.exists(p) or name in OWN_DIRS
                                  or name.endswith(SKIP_SUFFIXES)):
            try:
                os.unlink(p)
            except FileNotFoundError:
                pass
    for name in os.listdir(SRC):
        if name in PRIVATE or name in OWN_DIRS or name.endswith(SKIP_SUFFIXES):
            continue
        dst = os.path.join(DST, name)
        if os.path.lexists(dst):
            continue  # existing link, or something abby made itself
        try:
            os.symlink(os.path.join(SRC, name), dst)
        except FileExistsError:
            pass  # a second abby launching at the same moment won the race
    os.makedirs(os.path.join(DST, "projects"), exist_ok=True)


def munge(path):
    # Claude Code's project dir name for a cwd: every non-alphanumeric -> "-".
    return "".join(c if c.isalnum() else "-" for c in path)


def link_memory(cwd):
    """Share auto-memory: abby's projects/<p>/memory -> ~/.claude/projects/<p>/memory,
    for every project that has one, plus this cwd's (created if missing)."""
    src_projects = os.path.join(SRC, "projects")
    dst_projects = os.path.join(DST, "projects")
    os.makedirs(os.path.join(src_projects, munge(cwd), "memory"), exist_ok=True)
    for p in os.scandir(src_projects):
        mem = os.path.join(p.path, "memory")
        if not os.path.isdir(mem):
            continue
        d = os.path.join(dst_projects, p.name)
        link = os.path.join(d, "memory")
        if os.path.lexists(link):
            continue  # linked already, or a real one abby made (left alone)
        os.makedirs(d, exist_ok=True)
        try:
            os.symlink(mem, link)
        except FileExistsError:
            pass


def live_session_ids():
    ids = set()
    sessions = os.path.join(SRC, "sessions")
    for f in os.scandir(sessions) if os.path.isdir(sessions) else ():
        if not f.name.endswith(".json"):
            continue
        try:
            os.kill(int(f.name[:-5]), 0)
        except (ValueError, ProcessLookupError):
            continue
        except PermissionError:
            pass
        sid = load(f.path).get("sessionId")
        if sid:
            ids.add(sid)
    return ids


def is_abby_transcript(path):
    # The first real assistant reply records the model ("model":"abliterated-
    # ..."); "<synthetic>" ones (interrupts, errors) are Claude Code's own.
    # A session that never got a reply (e.g. its first request failed) is
    # abby's if an API error row names an abliteration model.
    errored_on_abby = False
    try:
        with open(path, errors="replace") as f:
            for line in f:
                if '"type":"assistant"' in line and '"model":"<synthetic>"' not in line:
                    return '"model":"abliterated-model' in line
                if '"type":"system"' in line and "abliterated-model" in line:
                    errored_on_abby = True
    except OSError:
        return None
    return True if errored_on_abby else None  # None: decide on a later launch


def migrate_sessions():
    """Move abby transcripts made before the split out of ~/.claude/projects,
    skipping sessions whose process is still running (it holds the file)."""
    cache = load(MIGRATE_CACHE)  # path -> [mtime, size] known not to be abby
    cutoff = time.time() - MIGRATE_DAYS * 86400
    live = None
    moved = 0
    for p in os.scandir(os.path.join(SRC, "projects")):
        if not p.is_dir():
            continue
        for f in os.scandir(p.path):
            if not f.name.endswith(".jsonl"):
                continue
            st = f.stat()
            if st.st_mtime < cutoff or cache.get(f.path) == [st.st_mtime, st.st_size]:
                continue
            verdict = is_abby_transcript(f.path)
            if verdict is False:
                cache[f.path] = [st.st_mtime, st.st_size]
                continue
            if verdict is None:
                continue
            sid = f.name[:-6]
            if live is None:
                live = live_session_ids()
            if sid in live:
                continue
            dest = os.path.join(DST, "projects", p.name)
            os.makedirs(dest, exist_ok=True)
            for name in (f.name, sid):  # the transcript and its <sid>/ dir
                src = os.path.join(p.path, name)
                if os.path.lexists(src) and not os.path.lexists(os.path.join(dest, name)):
                    os.rename(src, os.path.join(dest, name))
            moved += 1
    write_atomic(MIGRATE_CACHE, cache)
    return moved


def merged_hooks(base):
    """base's hooks plus LOOK_HOOKS (CC dedupes identical commands across sources)."""
    hooks = copy.deepcopy(base or {})
    for event, groups in LOOK_HOOKS.items():
        hooks.setdefault(event, [])
        for g in groups:
            if g not in hooks[event]:
                hooks[event].append(copy.deepcopy(g))
    return hooks


def look(live):
    sl = live.get("statusLine") or {}
    inner = sl.get("command") if sl.get("type") == "command" else None
    return {
        "theme": "custom:abby",
        "statusLine": {"type": "command", "padding": sl.get("padding", 0),
                       "command": shlex.join([STATUSLINE] + ([inner] if inner else []))},
        "spinnerVerbs": {"mode": "replace", "verbs": SPINNER_VERBS},
    }


# The gateway overlay. It goes in BOTH the user settings and a --settings
# file: --settings outranks project settings, and run from ~ the live
# ~/.claude/settings.json loads as *project* settings, which would otherwise
# override these (e.g. turn Remote Control back on, or the theme). The
# user-settings copy keeps a relaunch that lost the flag on abliteration.
# model and effort stay out of it so /model and /effort picks can still stick.
def overlay(live):
    return {
        **look(live),
        "env": {**(live.get("env") or {}), **GATEWAY_ENV,
                "ANTHROPIC_BASE_URL": BASE_URL[0]},
        "apiKeyHelper": shlex.join(KEY_CMD),
        "modelPicker": PICKER,
        # Remote Control and model auto-switching assume a claude.ai account.
        "remoteControlAtStartup": False,
        "switchModelsOnFlag": False,
    }


def build_settings():
    """Returns the saved model and effort to pass as flags (see overlay)."""
    live = load(os.path.join(SRC, "settings.json"), required=True)
    path = os.path.join(DST, "settings.json")
    prev = load(path)
    s = copy.deepcopy(live)
    ov = overlay(live)
    s.update(ov)
    s["hooks"] = merged_hooks(live.get("hooks"))  # live hooks + the pane tint
    s["model"] = prev.get("model") if is_ab(prev.get("model")) else MAIN
    s["autoCompactWindow"] = AUTO_COMPACT_WINDOW
    # Keep per-model picks (effort, /autocompact) made inside abby.
    ms = dict(live.get("modelSettings") or {})
    ms.update({k: v for k, v in (prev.get("modelSettings") or {}).items() if is_ab(k)})
    s["modelSettings"] = ms
    # Effort: never the live Claude one, so an effortLevel in abby's own
    # settings was saved from /effort inside abby and is kept.
    s.pop("effortLevel", None)
    if prev.get("effortLevel"):
        s["effortLevel"] = prev["effortLevel"]
    write_atomic(path, s)
    write_atomic(FLAGS_FILE, {**ov, "hooks": LOOK_HOOKS})
    os.makedirs(os.path.join(DST, "themes"), exist_ok=True)
    write_atomic(os.path.join(DST, "themes", "abby.json"), THEME)
    return s["model"], s.get("effortLevel") or DEFAULT_EFFORT


def build_global_config():
    # ~/.claude.json carries MCP servers, project trust, onboarding state.
    # A fresh copy each launch; abby's own writes stay in its copy, except
    # folder trust given inside abby, carried over so it isn't asked again.
    path = os.path.join(DST, ".claude.json")
    cfg = load(os.path.join(HOME, ".claude.json"))
    # abby isn't signed in to claude.ai. Leaving the account out also keeps
    # agent-gate.sh's Anthropic weekly-reserve gate off abby (it exits when
    # it finds no oauthAccount); abby spends no Anthropic quota.
    cfg.pop("oauthAccount", None)
    prev = load(path)
    for k, v in prev.items():
        if k.endswith(ACK_SUFFIXES) and v and not cfg.get(k):
            cfg[k] = v
    projects = cfg.setdefault("projects", {})
    for proj, st in (prev.get("projects") or {}).items():
        if isinstance(st, dict) and st.get("hasTrustDialogAccepted"):
            projects.setdefault(proj, {})["hasTrustDialogAccepted"] = True
    write_atomic(path, cfg)


BASE_URL = [UPSTREAM]  # set by main()


def guard_up():
    try:
        socket.create_connection(("127.0.0.1", GUARD_PORT), timeout=0.3).close()
        return True
    except OSError:
        return False


def ensure_guard():
    """The guard's URL once it answers, else UPSTREAM (abby still works)."""
    if not os.access(GUARD, os.X_OK):
        return UPSTREAM
    with open(GUARD, "rb") as f:
        rev = hashlib.sha256(f.read()).hexdigest()[:12]
    want = plistlib.dumps({
        "Label": GUARD_LABEL,
        "ProgramArguments": [os.path.realpath(sys.executable), "-I", GUARD],
        # A new guard script changes the plist, which reloads the agent.
        "EnvironmentVariables": {"ABBY_GUARD_PORT": str(GUARD_PORT), "ABBY_GUARD_REV": rev},
        "RunAtLoad": True,
        "KeepAlive": True,
        "StandardErrorPath": os.path.join(DST, "guard.err"),
    })
    try:
        with open(GUARD_PLIST, "rb") as f:
            have = f.read()
    except OSError:
        have = None
    domain = f"gui/{os.getuid()}"
    run = lambda *a: subprocess.run(["launchctl", *a], capture_output=True)
    if have != want:
        os.makedirs(os.path.dirname(GUARD_PLIST), exist_ok=True)
        with open(GUARD_PLIST, "wb") as f:
            f.write(want)
        run("bootout", f"{domain}/{GUARD_LABEL}")
        for _ in range(20):  # bootout returns before the port is free
            if not guard_up():
                break
            time.sleep(0.1)
        run("bootstrap", domain, GUARD_PLIST)
    elif not guard_up():
        run("kickstart", f"{domain}/{GUARD_LABEL}")
    for _ in range(30):
        if guard_up():
            return f"http://127.0.0.1:{GUARD_PORT}"
        time.sleep(0.1)
    print(f"abby: abby-guard didn't start (see {DST}/guard.err); going direct", file=sys.stderr)
    return UPSTREAM


def main():
    if not os.path.isdir(SRC):
        die(f"{SRC} not found")
    check_key()
    # ABBY_BASE_URL: point one launch at a local logging proxy instead.
    BASE_URL[0] = os.environ.get("ABBY_BASE_URL") or ensure_guard()
    link_tree()
    link_memory(os.getcwd())
    migrate_sessions()
    model, effort = build_settings()
    build_global_config()

    env = os.environ
    # Any of these in the inherited env would beat the settings above.
    for var in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_MODEL"):
        env.pop(var, None)
    env["CLAUDE_CONFIG_DIR"] = DST

    # Routing hint so a session's requests land where its prompt cache is
    # (abliteration docs: x-abliteration-session-id). One id per launch.
    if "ANTHROPIC_CUSTOM_HEADERS" not in env:
        env["ANTHROPIC_CUSTOM_HEADERS"] = f"x-abliteration-session-id: abby-{uuid.uuid4()}"

    args = sys.argv[1:]
    given = lambda flag: any(a == flag or a.startswith(flag + "=") for a in args)
    pre = ["--settings", FLAGS_FILE]
    # Flags so a saved pick beats the live settings' model/effort, which load
    # as project settings when run from ~. An in-session pick still wins.
    if not given("--model"):
        pre += ["--model", model]
    if effort and not given("--effort"):
        pre += ["--effort", effort]
    os.execvp("claude", ["claude"] + pre + args)


if __name__ == "__main__":
    main()
