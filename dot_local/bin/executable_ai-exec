#!/usr/bin/env python3
"""ai-exec: a drop-in for `codex exec` that falls back codex -> claude -> copilot.

    ai-exec [--search] [exec] <codex exec args...> [PROMPT | -]

Codex runs with the arguments verbatim (`codex [--search] exec ...`). When it
fails (nonzero exit, -o file missing/empty, or --output-schema output that
isn't JSON), the same task is translated for `claude -p`, then `copilot`.
Exit 0 if any backend succeeded, else the last nonzero code.

ai-exec-only flags (never passed to codex):
  --claude-model M     default $AI_EXEC_CLAUDE_MODEL or sonnet
  --copilot-model M    default $AI_EXEC_COPILOT_MODEL or auto
Env: AI_EXEC_{CODEX,CLAUDE,COPILOT}_BIN override the binaries;
     AI_EXEC_ORDER (default codex,claude,copilot) picks/orders backends.

Codex's usage-limit message is remembered in ~/.cache/ai-exec/
codex-limited-until (epoch secs) and codex is skipped until then. Fallbacks
are logged to ~/.local/state/ai-exec/log. SIGTERM/SIGINT/SIGHUP kill the
running backend's process group and exit; nothing further is tried. Each
backend runs in its own process group, watched by a tiny sh watchdog that
kills the group if ai-exec dies without cleaning up (SIGKILL included).

Fallback children run with CUA_NOTCH_IGNORE=1 in the -C dir. With -s
workspace-write, claude runs in its OS sandbox (Bash writes confined to the
work dir, edits auto-accepted only there) and copilot with --sandbox. In
read-only mode both may run a short list of read-only commands (git show/
diff/log/..., ls, cat, ...); claude's sandbox also denies writes to the
work dir. Copilot read-only runs unsandboxed (its sandbox also blocks reads
outside the work dir); a git shim on its PATH refuses `--output=F`.
"""

import json
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time

HOME = os.path.expanduser("~")
MEMO = os.path.join(HOME, ".cache/ai-exec/codex-limited-until")
LOG = os.path.join(HOME, ".local/state/ai-exec/log")
EXTRA_PATH = [os.path.join(HOME, ".local/bin"), os.path.join(HOME, ".bun/bin"),
              "/opt/homebrew/bin"]

# codex exec options that take a value (anything else is treated as boolean).
VALUE_FLAGS = {"-c", "--config", "--enable", "--disable", "-m", "--model",
               "--local-provider", "-p", "--profile", "-s", "--sandbox",
               "-C", "--cd", "--add-dir", "--thread-source",
               "--cyber-access-program", "--output-schema", "--color",
               "-o", "--output-last-message"}
MULTI_FLAGS = {"-i", "--image"}
# `codex exec <sub>` subcommands the fallbacks can't reproduce.
SUBCOMMANDS = {"resume", "fork", "review", "help"}

CLAUDE_EFFORT = {"none": "low", "minimal": "low", "low": "low",
                 "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}

# Shell commands a read-only fallback may run (codex read-only can run shell;
# reviews need `git show <sha>` / `git diff a..b`). No rg: `rg --pre CMD`
# runs anything, and both CLIs have a native grep tool.
READONLY_COMMANDS = ["git show", "git diff", "git log", "git status", "git blame",
                     "git rev-parse", "git ls-files", "ls", "cat", "head", "tail", "wc"]

# Codex's reset time: "try again at Oct 31st, 2026 11:10 PM" or, when the
# reset is today, a bare "try again at 11:50 PM".
RESET_RE = re.compile(r"try again at\s+(?:([a-z]{3})[a-z]*\.?\s+(\d{1,2})(?:st|nd|rd|th)?,?\s+"
                      r"(\d{4}),?\s+)?(\d{1,2}):(\d{2})\s*([ap])?\.?m?\.?", re.I)

# Kills the backend's process group when ai-exec's end of the pipe closes
# while a group is still registered ("<pgid>" lines; "0" = none running).
WATCHDOG = r"""trap '' HUP INT TERM
pg=0
while read -r line; do pg=$line; done
[ "$pg" -gt 0 ] 2>/dev/null || exit 0
kill -TERM -"$pg" 2>/dev/null || exit 0
i=0
while [ $i -lt 20 ] && kill -0 -"$pg" 2>/dev/null; do sleep 0.1; i=$((i+1)); done
kill -KILL -"$pg" 2>/dev/null
exit 0
"""

# First on PATH for copilot read-only: `git show/diff/log --output=F` (any
# abbreviation git accepts) is the one write the shell allowlist lets through.
GIT_SHIM = """#!/bin/sh
for a in "$@"; do
  case "$a" in
    --o|--ou|--out|--outp|--outpu|--output|--o=*|--ou=*|--out=*|--outp=*|--outpu=*|--output=*)
      echo "ai-exec: git --output is not allowed in read-only mode" >&2; exit 1 ;;
  esac
done
exec %s "$@"
"""

current = None          # the running child Popen, for the signal handler
spawning = False        # a signal during Popen is deferred until `current` is set
pending = []
watchdog_fd = None      # write end of the watchdog's pipe


def warn(msg):
    sys.stderr.write("ai-exec: %s\n" % msg)
    sys.stderr.flush()


def log(msg):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as fh:
            fh.write("%s cwd=%s %s\n" % (time.strftime("%Y-%m-%dT%H:%M:%S"),
                                         os.getcwd(), msg))
    except OSError:
        pass


# --- arguments -----------------------------------------------------------------

class Args:
    def __init__(self):
        self.search = False
        self.codex_args = []        # passed to `codex exec` verbatim
        self.prompt = None          # positional prompt ('-' = stdin)
        self.model = None
        self.effort = None
        self.sandbox = "read-only"
        self.cd = None
        self.out = None
        self.schema = None
        self.json = False
        self.images = []
        self.add_dirs = []
        self.subcommand = None
        self.claude_model = os.environ.get("AI_EXEC_CLAUDE_MODEL") or "sonnet"
        self.copilot_model = os.environ.get("AI_EXEC_COPILOT_MODEL") or "auto"


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        v = v[1:-1]
    return v


def parse(argv):
    a = Args()
    positionals = []
    saw_exec = False
    i = 0
    rest_positional = False
    while i < len(argv):
        tok = argv[i]
        i += 1
        if rest_positional:
            positionals.append(tok)
            a.codex_args.append(tok)
            continue
        if tok == "--":
            rest_positional = True
            a.codex_args.append(tok)
            continue
        if tok in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if tok == "--search":
            a.search = True
            continue
        if tok == "exec" and not saw_exec and not positionals:
            saw_exec = True
            continue
        name, eq, inline = tok.partition("=") if tok.startswith("--") else (tok, "", "")
        if name in ("--claude-model", "--copilot-model"):
            val = inline if eq else (argv[i] if i < len(argv) else "")
            if not eq:
                i += 1
            setattr(a, name[2:].replace("-", "_"), val)
            continue
        if name in MULTI_FLAGS:
            a.codex_args.append(tok)
            if eq:
                a.images.append(inline)
            while i < len(argv) and not argv[i].startswith("-"):
                a.images.append(argv[i])
                a.codex_args.append(argv[i])
                i += 1
            continue
        if name in VALUE_FLAGS:
            a.codex_args.append(tok)
            if eq:
                val = inline
            elif i < len(argv):
                val = argv[i]
                a.codex_args.append(val)
                i += 1
            else:
                val = ""
            apply_value(a, name, val)
            continue
        if tok == "--json":
            a.json = True
        elif tok == "--dangerously-bypass-approvals-and-sandbox":
            a.sandbox = "danger-full-access"
        a.codex_args.append(tok)
        if tok == "-" or not tok.startswith("-"):
            if not positionals and tok in SUBCOMMANDS:
                a.subcommand = tok
            positionals.append(tok)
    # Last positional: robust to an unknown flag having eaten a value slot.
    if positionals and not a.subcommand:
        a.prompt = positionals[-1]
    return a


def apply_value(a, name, val):
    if name in ("-m", "--model"):
        a.model = val
    elif name in ("-s", "--sandbox"):
        a.sandbox = val
    elif name in ("-C", "--cd"):
        a.cd = val
    elif name in ("-o", "--output-last-message"):
        a.out = val
    elif name == "--output-schema":
        a.schema = val
    elif name == "--add-dir":
        a.add_dirs.append(val)
    elif name in ("-c", "--config"):
        key, _, v = val.partition("=")
        key = key.strip()
        if key == "model_reasoning_effort":
            a.effort = unquote(v)
        elif key == "sandbox_mode":
            a.sandbox = unquote(v)


def read_prompt(a):
    """Returns (stdin_bytes or None, fallback prompt text)."""
    data = None
    try:
        mode = os.fstat(0).st_mode
        piped = stat.S_ISFIFO(mode) or stat.S_ISREG(mode)
        tty = os.isatty(0)
    except OSError:
        piped, tty = False, True
    if a.prompt in (None, "-"):
        if a.prompt == "-" or not tty:
            data = sys.stdin.buffer.read()
        text = (data or b"").decode("utf-8", "replace")
    else:
        text = a.prompt
        if piped:       # codex appends piped stdin as a <stdin> block
            data = sys.stdin.buffer.read()
            if data:
                text += "\n\n<stdin>\n%s\n</stdin>" % data.decode("utf-8", "replace")
    return data, text


# --- running a child -----------------------------------------------------------

def find_bin(name):
    override = os.environ.get("AI_EXEC_%s_BIN" % name.upper())
    if override:
        return override if os.path.exists(override) or shutil.which(override) else None
    path = os.pathsep.join([os.environ.get("PATH", "")] + EXTRA_PATH)
    return shutil.which(name, path=path)


def tell_watchdog(pgid):
    """Register the running group (0 = none) with the watchdog, starting it
    on first use. Its pipe's write end is non-inheritable, so no backend
    holds it open: when ai-exec dies, by any means, the watchdog sees EOF."""
    global watchdog_fd
    try:
        if watchdog_fd is None:
            if not pgid:
                return
            r, w = os.pipe()
            subprocess.Popen(["/bin/sh", "-c", WATCHDOG], stdin=r,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            os.close(r)
            watchdog_fd = w
        os.write(watchdog_fd, b"%d\n" % pgid)
    except OSError:
        pass


def run(argv, cwd, env, stdin_data, on_stdout_line=None):
    """Run argv in its own process group; stderr streams through.
    Returns (rc, stdout_text, stderr_tail)."""
    global current, spawning
    spawning = True
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env,
                                stdin=subprocess.PIPE if stdin_data is not None else subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                start_new_session=True, close_fds=False)
    except OSError as e:
        spawning = False
        if pending:
            on_signal(pending[0], None)
        return 127, "", str(e)
    current = proc
    tell_watchdog(proc.pid)
    spawning = False
    if pending:
        on_signal(pending[0], None)
    out_chunks, err_tail = [], [b""]

    def pump_out():
        for line in iter(proc.stdout.readline, b""):
            out_chunks.append(line)
            if on_stdout_line:
                on_stdout_line(line)

    def pump_err():
        while True:
            chunk = os.read(proc.stderr.fileno(), 65536)
            if not chunk:
                break
            try:
                sys.stderr.buffer.write(chunk)
                sys.stderr.flush()
            except (OSError, ValueError):
                pass
            err_tail[0] = (err_tail[0] + chunk)[-65536:]

    def feed():
        try:
            proc.stdin.write(stdin_data)
            proc.stdin.close()
        except OSError:
            pass

    threads = [threading.Thread(target=pump_out), threading.Thread(target=pump_err)]
    if stdin_data is not None:
        threads.append(threading.Thread(target=feed))
    for t in threads:
        t.daemon = True
        t.start()
    rc = proc.wait()
    tell_watchdog(0)
    for t in threads:
        t.join(5)
    current = None
    return (rc, b"".join(out_chunks).decode("utf-8", "replace"),
            err_tail[0].decode("utf-8", "replace"))


def on_signal(signum, _frame):
    """The caller is enforcing a timeout or cancelling: take the backend down
    with us and stop. Never fall through to the next backend."""
    if spawning:            # Popen in flight: finish it, then come back here
        pending.append(signum)
        return
    proc = current
    if proc is not None:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            pass
        # Reap directly: proc.poll() can't while the main thread sits in
        # proc.wait() holding Popen's lock, so it would always spin the 2s.
        deadline = time.time() + 2
        while time.time() < deadline:
            try:
                if os.waitpid(proc.pid, os.WNOHANG)[0]:
                    break
            except ChildProcessError:
                break
            time.sleep(0.02)
        try:
            os.killpg(proc.pid, signal.SIGKILL)     # stragglers in the group
        except OSError:
            pass
        tell_watchdog(0)
    log("killed by signal %d" % signum)
    os._exit(128 + signum)


# --- output helpers ------------------------------------------------------------

def strip_fences(text):
    t = text.strip()
    m = re.match(r"^```[A-Za-z0-9_-]*\s*\n(.*?)\n?```\s*$", t, re.S)
    return m.group(1).strip() if m else t


def extract_json(text):
    """The first JSON object/array in text (fences stripped), or None."""
    t = strip_fences(text)
    try:
        return json.loads(t)
    except ValueError:
        pass
    dec = json.JSONDecoder()
    for m in re.finditer(r"[\[{]", t):
        try:
            return dec.raw_decode(t[m.start():])[0]
        except ValueError:
            continue
    return None


def fits_schema(value, schema):
    """Light check: top-level type and required keys. Not a full validator."""
    if value is None:
        return False
    want = schema.get("type") if isinstance(schema, dict) else None
    if want == "object":
        if not isinstance(value, dict):
            return False
        return all(k in value for k in schema.get("required", []))
    if want == "array":
        return isinstance(value, list)
    return True


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def stat_key(path):
    try:
        st = os.stat(path)
        return (st.st_ino, st.st_size, st.st_mtime_ns)
    except OSError:
        return None


# --- codex usage-limit memo ----------------------------------------------------

def memo_until():
    try:
        with open(MEMO) as fh:
            return float(fh.read().strip() or 0)
    except (OSError, ValueError):
        return 0.0


def parse_reset(text, now=None):
    """Epoch of the LAST "try again at ..." in text, or None."""
    now = time.time() if now is None else now
    matches = list(RESET_RE.finditer(text))
    if not matches:
        return None
    mon, day, year, hh, mm, ap = matches[-1].groups()
    try:
        hh, mm = int(hh), int(mm)
        if ap:
            hh = hh % 12 + (12 if ap.lower() == "p" else 0)
        if mon:
            st = time.strptime("%s %s %s %d %d" % (mon.title(), day, year, hh, mm), "%b %d %Y %H %M")
            return time.mktime(st)
        # bare time: today, or tomorrow if that time has passed
        lt = time.localtime(now)
        t = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, hh, mm, 0, 0, 0, -1))
        if t <= now:
            t = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday + 1, hh, mm, 0, 0, 0, -1))
        return t
    except (ValueError, OverflowError):
        return None


def remember_limit(text):
    until = time.time() + 3600
    parsed = parse_reset(text)
    if parsed and parsed > time.time():
        until = parsed
    try:
        os.makedirs(os.path.dirname(MEMO), exist_ok=True)
        with open(MEMO, "w") as fh:
            fh.write("%d\n" % until)
    except OSError:
        pass
    return until


# --- backends ------------------------------------------------------------------
# Each returns (ok, rc, final_text, reason). Fallbacks emit their own output on
# success; codex's output has already gone out (or is flushed here).

def try_codex(binary, a, ctx):
    argv = [binary] + (["--search"] if a.search else []) + ["exec"] + a.codex_args
    held = []

    def passthrough(line):
        # Stream codex's JSONL live, but hold back TRAILING failure events: if
        # we fall back, callers should see the fallback's events, not codex's
        # error. An error followed by more events (a retry notice) goes out in
        # order, so a successful run's stream is byte-for-byte codex's.
        if not a.json:
            return
        try:
            typ = json.loads(line).get("type")
        except (ValueError, AttributeError):
            typ = None
        if typ in ("error", "turn.failed"):
            held.append(line)
            return
        for h in held:
            sys.stdout.buffer.write(h)
        del held[:]
        sys.stdout.buffer.write(line)
        sys.stdout.flush()

    before = stat_key(ctx["out"]) if ctx["out"] else None
    rc, out, err = run(argv, None, os.environ.copy(), ctx["stdin"], passthrough)
    errors = codex_errors(out, err)
    if rc != 0 and re.search(r"usage limit", errors, re.I):
        until = remember_limit(errors)
        return False, rc, None, "usage limit until %s" % time.strftime("%b %d %H:%M", time.localtime(until))
    if rc != 0:
        return False, rc, None, "exit %d%s" % (rc, last_line(err))
    final = None
    if ctx["out"]:
        after = stat_key(ctx["out"])
        if after is None or after[1] == 0 or after == before:
            return False, 1, None, "output file missing/empty"
        with open(ctx["out"], errors="replace") as fh:
            final = fh.read()
    elif a.json:
        for line in out.splitlines():
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            item = ev.get("item") or {}
            if ev.get("type") == "item.completed" and item.get("type") == "agent_message":
                final = item.get("text")
    else:
        final = out
    if ctx["schema"] is not None and extract_json(final or "") is None:
        return False, 1, None, "output is not valid JSON"
    if a.json:
        for line in held:       # codex succeeded: its non-fatal errors are its own business
            sys.stdout.buffer.write(line)
    else:
        sys.stdout.write(out)
    sys.stdout.flush()
    return True, 0, final, ""


def codex_errors(out, err):
    """Codex's own error text only: --json error/turn.failed messages and the
    trailing ERROR: lines of stderr. Never the whole stream - plain codex
    echoes the prompt to stderr, and prompts (agent transcripts) quote these
    very errors."""
    msgs = []
    for line in out.splitlines():
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if ev.get("type") == "error":
            msgs.append(str(ev.get("message", "")))
        elif ev.get("type") == "turn.failed":
            msgs.append(str((ev.get("error") or {}).get("message", "")))
    trailing = []
    for line in reversed(err.splitlines()):
        if not line.strip():
            continue
        if not line.startswith("ERROR"):
            break
        trailing.append(line)
    return "\n".join(msgs + trailing[::-1])


def last_line(err):
    lines = [l.strip() for l in err.splitlines() if l.strip()]
    return (": " + lines[-1][:160]) if lines else ""


def fallback_env():
    env = os.environ.copy()
    env["CUA_NOTCH_IGNORE"] = "1"
    return env


def try_claude(binary, a, ctx):
    write = ctx["write"]
    # Reads go anywhere through Read(//**), images included, so image dirs
    # never need --add-dir (which would make them writable in write mode).
    allow = ["Read(//**)"]
    if write:
        tools = ["Bash", "Read", "Write", "Edit", "Grep", "Glob"]
        dirs = [ctx["cwd"]] + ctx["dirs"]
        # Claude Code's OS sandbox: Bash writes are confined to the working
        # dirs, unsandboxed retries are refused, edits outside are denied
        # (--permission-prompts none: nobody can approve them).
        sandbox = {"enabled": True, "autoAllowBashIfSandboxed": True,
                   "allowUnsandboxedCommands": False}
    else:
        # Bash only for the read-only allowlist (anything else would prompt,
        # and --permission-prompts none denies it), and the sandbox denies
        # writes to the work dir so even an allowed `git diff --output=F`
        # can't write.
        tools = ["Bash", "Read", "Grep", "Glob"]
        allow += ["Bash(%s *)" % c for c in READONLY_COMMANDS]
        dirs = ctx["dirs"]
        sandbox = {"enabled": True, "autoAllowBashIfSandboxed": False,
                   "allowUnsandboxedCommands": False,
                   "filesystem": {"denyWrite": [ctx["cwd"]] + dirs}}
    if a.search:
        tools += ["WebSearch", "WebFetch"]
        allow += ["WebSearch", "WebFetch"]
    settings = {"permissions": {"allow": allow}, "sandbox": sandbox}
    argv = [binary, "-p", "--model", a.claude_model, "--no-session-persistence",
            "--setting-sources", "", "--strict-mcp-config",
            "--permission-prompts", "none", "--output-format", "json",
            "--settings", json.dumps(settings)]
    if a.effort in CLAUDE_EFFORT:
        argv += ["--effort", CLAUDE_EFFORT[a.effort]]
    if write:
        argv += ["--permission-mode", "acceptEdits"]
    for d in dirs:
        argv += ["--add-dir", d]
    if ctx["schema"] is not None:
        # claude rejects a top-level "$schema" draft URL it can't resolve
        # (every transcript2notes schema has one); the caller's file is untouched.
        sch = ctx["schema"]
        if isinstance(sch, dict):
            sch = {k: v for k, v in sch.items() if k not in ("$schema", "$id")}
        argv += ["--json-schema", json.dumps(sch)]
    argv += ["--tools", ",".join(tools)]      # variadic: keep it last; prompt is on stdin
    prompt = ctx["prompt"]
    if ctx["images"]:
        prompt = ("Attached images — read each with the Read tool: %s\n\n"
                  % ", ".join(ctx["images"])) + prompt
    dot_claude = os.path.join(ctx["cwd"], ".claude")
    had_dot_claude = os.path.exists(dot_claude)
    rc, out, err = run(argv, ctx["cwd"], fallback_env(), prompt.encode("utf-8"))
    if not had_dot_claude:      # claude leaves an empty .claude/.cc-writes behind
        for d in (os.path.join(dot_claude, ".cc-writes"), dot_claude):
            try:
                os.rmdir(d)
            except OSError:
                pass
    res = {}
    for candidate in (out.strip(), (out.strip().splitlines() or [""])[-1]):
        try:
            res = json.loads(candidate)
            break
        except ValueError:
            continue
    if not isinstance(res, dict):
        res = {}
    if rc != 0 or not res or res.get("is_error") or res.get("subtype") != "success":
        why = res.get("result") or res.get("subtype") or last_line(err).lstrip(": ")
        return False, rc or 1, None, "exit %d%s" % (rc, (": " + str(why)[:160]) if why else "")
    final = res.get("result") or ""
    if ctx["schema"] is not None:
        value = res.get("structured_output")
        if value is None:
            value = extract_json(final)
        if not fits_schema(value, ctx["schema"]):
            return False, 1, None, "output is not valid JSON for the schema"
        final = json.dumps(value)
    if not final.strip():
        return False, 1, None, "empty answer"
    return True, 0, final, ""


def try_copilot(binary, a, ctx):
    argv = [binary, "-s", "--no-color", "--no-custom-instructions",
            "--disable-builtin-mcps", "--no-ask-user", "--model", a.copilot_model]
    if a.effort and a.copilot_model != "auto":     # auto rejects --reasoning-effort
        argv += ["--reasoning-effort", a.effort]
    images, tmpd, env = ctx["images"], None, fallback_env()
    if ctx["write"]:
        argv += ["--allow-all-tools", "--sandbox", "--add-dir", ctx["cwd"]]
        # --sandbox blocks attachments outside the work dir and temp, so the
        # images ride along as copies in a temp dir (never --add-dir: writable).
        if images:
            tmpd = tempfile.mkdtemp(prefix="ai-exec-img-")
            copies = []
            for n, img in enumerate(images):
                dst = os.path.join(tmpd, "%d-%s" % (n, os.path.basename(img)))
                try:
                    shutil.copyfile(img, dst)
                    copies.append(dst)
                except OSError:
                    copies.append(img)
            images = copies
    else:
        # Reads anywhere (like codex read-only), no file writes, and only the
        # read-only shell allowlist (no --allow-all-tools: anything else is
        # denied in prompt mode). Compound commands and redirections need
        # every part allowed, so `git show && touch x` / `> f` are refused.
        # No --sandbox here: it would also block reads outside the work dir;
        # a git shim on PATH refuses the one write the allowlist lets through.
        argv += ["--allow-all-paths", "--deny-tool", "write"]
        for c in READONLY_COMMANDS:
            argv += ["--allow-tool", "shell(%s:*)" % c]
        if not a.search:
            argv += ["--deny-tool", "url"]
        real_git = shutil.which("git")
        if real_git:
            tmpd = tempfile.mkdtemp(prefix="ai-exec-git-")
            shim = os.path.join(tmpd, "git")
            with open(shim, "w") as fh:
                fh.write(GIT_SHIM % shlex.quote(real_git))
            os.chmod(shim, 0o755)
            env["PATH"] = tmpd + os.pathsep + env.get("PATH", "")
    if a.search:
        argv += ["--allow-all-urls"]
    for d in ctx["dirs"]:
        argv += ["--add-dir", d]
    for img in images:
        argv += ["--attachment", img]
    prompt = ctx["prompt"]
    if ctx["schema"] is not None:
        prompt += ("\n\nRespond with ONLY a JSON value (no prose, no code fences) "
                   "that validates against this JSON Schema:\n%s" % json.dumps(ctx["schema"]))
    # The prompt goes on stdin: copilot reads a piped prompt, and argv can't
    # carry a ~400k-char one.
    try:
        rc, out, err = run(argv, ctx["cwd"], env, prompt.encode("utf-8"))
    finally:
        if tmpd:
            shutil.rmtree(tmpd, ignore_errors=True)
    if rc != 0:
        return False, rc, None, "exit %d%s" % (rc, last_line(err))
    final = out.strip()
    if ctx["schema"] is not None:
        value = extract_json(final)
        if not fits_schema(value, ctx["schema"]):
            return False, 1, None, "output is not valid JSON for the schema"
        final = json.dumps(value)
    if not final:
        return False, 1, None, "empty answer"
    return True, 0, final, ""


BACKENDS = {"codex": try_codex, "claude": try_claude, "copilot": try_copilot}


# --- main ----------------------------------------------------------------------

def main(argv):
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, on_signal)
    a = parse(argv)
    stdin_data, prompt = read_prompt(a)

    base = os.getcwd()
    absp = lambda p: os.path.abspath(os.path.join(base, os.path.expanduser(p)))
    cwd = absp(a.cd) if a.cd else base
    schema = None
    if a.schema:
        try:
            with open(absp(a.schema)) as fh:
                schema = json.load(fh)
        except (OSError, ValueError) as e:
            warn("can't read --output-schema %s: %s (fallbacks run without it)" % (a.schema, e))
            schema = {}
    images = [absp(p) for p in a.images]
    ctx = {"stdin": stdin_data, "prompt": prompt, "cwd": cwd,
           "out": absp(a.out) if a.out else None, "schema": schema,
           "write": a.sandbox != "read-only", "images": images,
           # codex --add-dir only: image dirs are read, never added (they'd be writable)
           "dirs": sorted({absp(d) for d in a.add_dirs})}

    order = [b.strip() for b in os.environ.get("AI_EXEC_ORDER", "codex,claude,copilot").split(",")
             if b.strip() in BACKENDS]
    if a.subcommand:        # `exec resume/review`: codex only
        order = [b for b in order if b == "codex"]
    attempts = [(name, find_bin(name)) for name in order]
    attempts = [(n, b) for n, b in attempts if b]

    rc, failed = 1, []
    for idx, (name, binary) in enumerate(attempts):
        nxt = attempts[idx + 1][0] if idx + 1 < len(attempts) else None
        if name == "codex" and memo_until() > time.time():
            reason = "usage limit until %s" % time.strftime("%b %d %H:%M", time.localtime(memo_until()))
            failed.append("codex skipped (%s)" % reason)
            if nxt:
                warn("codex skipped (%s); trying %s" % (reason, nxt))
            continue
        if name != "codex" and not prompt.strip():
            failed.append("%s skipped (no prompt)" % name)
            continue
        if name != "codex" and not os.path.isdir(cwd):
            failed.append("%s skipped (no such dir %s)" % (name, cwd))
            continue
        ok, code, final, reason = BACKENDS[name](binary, a, ctx)
        if ok:
            if name != "codex":
                if ctx["out"]:
                    with open(ctx["out"], "w") as fh:
                        fh.write(final)
                if a.json:
                    emit({"type": "thread.started", "thread_id": "ai-exec-%s-%d" % (name, os.getpid())})
                    emit({"type": "turn.started"})
                    emit({"type": "item.completed",
                          "item": {"id": "item_0", "type": "agent_message", "text": final}})
                    emit({"type": "turn.completed",
                          "usage": {"input_tokens": 0, "cached_input_tokens": 0, "output_tokens": 0}})
                else:
                    sys.stdout.write(final if final.endswith("\n") else final + "\n")
                    sys.stdout.flush()
            if failed:
                log("%s; %s succeeded" % ("; ".join(failed), name))
            return 0
        rc = code or 1
        failed.append("%s failed (%s)" % (name, reason))
        if nxt:
            warn("%s failed (%s); trying %s" % (name, reason, nxt))
            log("%s failed (%s); trying %s" % (name, reason, nxt))

    msg = "; ".join(failed) or "no backend available (order: %s)" % ",".join(order)
    warn("all backends failed: %s" % msg)
    log("all backends failed: %s" % msg)
    if a.json:
        emit({"type": "error", "message": "ai-exec: " + msg})
        emit({"type": "turn.failed", "error": {"message": "ai-exec: " + msg}})
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
