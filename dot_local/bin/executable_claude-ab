#!/bin/sh
# claude-ab: Claude Code running on abliteration.ai instead of Anthropic.
#
# Main model: abliterated-model-large-v2 (GLM-5.3, 1M ctx, text-only, the top tier).
# Background/haiku tasks: abliterated-model-large-flash (cheaper, takes images).
# Override per run: CLAUDE_AB_MODEL=abliterated-model claude-ab ...
#
# Key lookup: $ABLITERATION_API_KEY, else the login keychain item
# "abliteration-api-key". Store it once with:
#   security add-generic-password -U -a "$USER" -s abliteration-api-key -w
# (no value after -w, so it prompts instead of landing in shell history)
set -eu

key="${ABLITERATION_API_KEY:-}"
if [ -z "$key" ]; then
  key="$(security find-generic-password -a "$USER" -s abliteration-api-key -w 2>/dev/null || true)"
fi
if [ -z "$key" ]; then
  echo "claude-ab: no abliteration.ai key. Add it with:" >&2
  echo "  security add-generic-password -U -a \"\$USER\" -s abliteration-api-key -w" >&2
  exit 1
fi

main="${CLAUDE_AB_MODEL:-abliterated-model-large-v2}"
fast="${CLAUDE_AB_FAST_MODEL:-abliterated-model-large-flash}"

# An Anthropic key in the env would win over the bearer token; drop it.
unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="https://api.abliteration.ai"
export ANTHROPIC_AUTH_TOKEN="$key"
export ANTHROPIC_MODEL="$main"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$main"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$main"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$fast"
export CLAUDE_CODE_SUBAGENT_MODEL="$main"

exec claude "$@"
