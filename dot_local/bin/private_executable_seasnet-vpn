#!/opt/homebrew/bin/python3
"""One userspace UCLA VPN forward, exclusively to cs35l.seas.ucla.edu:22."""
import fcntl
from contextlib import contextmanager, redirect_stdout
import hashlib
import json
import os
from pathlib import Path
import plistlib
import shlex
import signal
import socket
import subprocess
import sys
import time
import uuid
from urllib.parse import urlsplit

STATE = Path.home() / ".local/state/seasnet-vpn"
PIDFILE = STATE / "openconnect.pid"
BASELINE = STATE / "network-before.json"
PORT = 42235
TARGET = "cs35l.seas.ucla.edu"
OPENCONNECT = "/opt/homebrew/bin/openconnect"
OCPROXY = "/opt/homebrew/bin/ocproxy"
SELF = Path.home() / ".local/bin/seasnet-vpn"
LOGIN_SOURCE = Path.home() / ".config/seasnet-vpn/Login.swift"
LOGIN_APP = Path.home() / "Applications/SEASnet VPN Login.app"
LOGIN_BUNDLE = "co.mackhaymond.seasnet-vpn-login"
IDLE_SECONDS = 15 * 60
LOGIN_TIMEOUT = 5 * 60


@contextmanager
def control_lock(wait=False):
    with (STATE / "control.lock").open("w") as lock:
        deadline = time.monotonic() + LOGIN_TIMEOUT + 30
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if not wait or time.monotonic() >= deadline:
                    raise RuntimeError("Another VPN start/stop is in progress.")
                time.sleep(0.2)
        yield


def touch_activity():
    (STATE / "last-used").touch(mode=0o600)


def active_connections(clean=False):
    busy = 0
    leases = STATE / "connections"
    leases.mkdir(exist_ok=True, mode=0o700)
    for path in leases.iterdir():
        try:
            with path.open("a") as lease:
                try:
                    fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    busy += 1
                    continue
                if clean:
                    path.unlink(missing_ok=True)
        except FileNotFoundError:
            pass
    # Also protect connections opened before lease tracking was installed.
    sockets = capture(["/usr/sbin/lsof", "-nP", "-a", "-u", str(os.getuid()),
                       f"-iTCP:{PORT}", "-sTCP:ESTABLISHED", "-Fn"]).stdout
    return max(busy, sum(line.startswith(f"n127.0.0.1:{PORT}->") for line in sockets.splitlines()))


def ensure_idle_watch():
    subprocess.Popen([str(SELF), "idle"], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def idle_watch():
    with (STATE / "idle.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        (STATE / "idle.pid").write_text(str(os.getpid()) + "\n")
        try:
            while owned_pid():
                try:
                    with control_lock():
                        if active_connections(clean=True):
                            touch_activity()
                        else:
                            activity = STATE / "last-used"
                            if not activity.exists():
                                touch_activity()
                            elif time.time() - activity.stat().st_mtime >= IDLE_SECONDS:
                                stop()
                                return 0
                except RuntimeError:
                    pass
                time.sleep(15)
        finally:
            (STATE / "idle.pid").unlink(missing_ok=True)
    return 0


def build_login():
    digest = hashlib.sha256(LOGIN_SOURCE.read_bytes() + b"login-app-v1").hexdigest()
    stamp = STATE / "login-build.sha256"
    binary = LOGIN_APP / "Contents/MacOS/SEASnetVPNLogin"
    if stamp.exists() and stamp.read_text().strip() == digest and binary.exists():
        return
    if LOGIN_APP.exists():
        info = LOGIN_APP / "Contents/Info.plist"
        if not info.exists() or plistlib.loads(info.read_bytes()).get("CFBundleIdentifier") != LOGIN_BUNDLE:
            raise RuntimeError("An unrelated app already occupies the login-app path.")
    binary.parent.mkdir(parents=True, exist_ok=True)
    info = {"CFBundleIdentifier": LOGIN_BUNDLE, "CFBundleName": "SEASnet VPN Login",
            "CFBundleDisplayName": "SEASnet VPN Login", "CFBundleExecutable": "SEASnetVPNLogin",
            "CFBundlePackageType": "APPL", "CFBundleVersion": "1", "CFBundleShortVersionString": "1.0",
            "LSMinimumSystemVersion": "13.0", "NSHighResolutionCapable": True,
            "NSAppTransportSecurity": {"NSAllowsLocalNetworking": True, "NSAllowsArbitraryLoadsInWebContent": True}}
    temporary = binary.with_suffix(".build")
    subprocess.run(["/usr/bin/xcrun", "swiftc", "-O", "-framework", "Cocoa", "-framework", "WebKit",
                    str(LOGIN_SOURCE), "-o", str(temporary)], check=True, timeout=120)
    temporary.replace(binary)
    (LOGIN_APP / "Contents/Info.plist").write_bytes(plistlib.dumps(info))
    subprocess.run(["/usr/bin/codesign", "--force", "--sign", "-", str(LOGIN_APP)],
                   check=True, capture_output=True, timeout=30)
    register = "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
    subprocess.run([register, "-f", str(LOGIN_APP)], check=True, capture_output=True, timeout=30)
    stamp.write_text(digest + "\n")


def write_login_result(result):
    request = STATE / "login-request.json"
    if request.exists():
        data = json.loads(request.read_text())
        (STATE / "login-result.json").write_text(json.dumps({"id": data["id"], "result": result}) + "\n")


def login_cancelled():
    request, result = STATE / "login-request.json", STATE / "login-result.json"
    if not request.exists() or not result.exists():
        return False
    try:
        a, b = json.loads(request.read_text()), json.loads(result.read_text())
        return a["id"] == b["id"] and b["result"] in ("cancelled", "failed")
    except (ValueError, KeyError):
        return False


def capture(args):
    return subprocess.run(args, capture_output=True, text=True, timeout=15)


def process(pid):
    # macOS truncates comm to 15 columns when args follows it. Request comm
    # separately as the final wide column so the executable path stays intact.
    executable = capture(["/bin/ps", "-ww", "-p", str(pid), "-o", "comm="]).stdout.strip()
    info = capture(["/bin/ps", "-ww", "-p", str(pid), "-o", "uid=,ppid=,args="]).stdout.strip().split(None, 2)
    if len(info) != 3 or not executable:
        return ""
    return " ".join([info[0], info[1], executable, info[2]])


def owned_pid():
    try:
        pid = int(PIDFILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        return None
    info = process(pid).split(None, 3)
    if (len(info) == 4 and int(info[0]) == os.getuid()
            and Path(info[2]).name == "openconnect"
            and str(PIDFILE) in shlex.split(info[3])):
        return pid
    return None


def listener_ready():
    output = capture(["/usr/sbin/lsof", "-nP", "-a", "-u", str(os.getuid()),
                      f"-iTCP:{PORT}", "-sTCP:LISTEN", "-Fpnc"]).stdout
    listener_pid = None
    command = None
    for line in output.splitlines():
        if line.startswith("p"):
            listener_pid = int(line[1:])
            command = None
        elif line.startswith("c"):
            command = line[1:]
        elif line.startswith("n") and line[1:] == f"127.0.0.1:{PORT}" and command == "ocproxy":
            info = process(listener_pid).split(None, 3)
            # OpenConnect's daemon fork can reparent ocproxy. Verify its actual
            # executable, owner and fixed destination rather than its parent PID.
            if len(info) == 4 and int(info[0]) == os.getuid() and Path(info[2]).name == "ocproxy":
                args = shlex.split(info[3])
                if args[1:] == ["-L", f"{PORT}:{TARGET}:22", "-k", "30"]:
                    return True
    return False


def snapshot():
    routes = {}
    for family in ("inet", "inet6"):
        result = capture(["/usr/sbin/netstat", "-rn", "-f", family])
        result.check_returncode()
        entries = []
        for line in result.stdout.splitlines():
            fields = line.split()
            if len(fields) >= 4 and "U" in fields[2] and "L" not in fields[2]:
                entries.append([fields[0], fields[1], fields[3]])
        routes[family] = sorted(entries)
    dns = capture(["/usr/sbin/scutil", "--dns"])
    dns.check_returncode()
    ip = capture(["/usr/bin/curl", "-4fsS", "--max-time", "10", "https://api.ipify.org"])
    return {"routes": routes, "dns": dns.stdout,
            "public_ipv4": ip.stdout.strip() if ip.returncode == 0 else None}


def verify():
    if not BASELINE.exists():
        print("No connection baseline yet. Run seasnet-vpn start first.")
        return 1
    before = json.loads(BASELINE.read_text())
    after = snapshot()
    unchanged = True
    for key in ("routes", "dns", "public_ipv4"):
        if key == "public_ipv4" and (before[key] is None or after[key] is None):
            print("Public IPv4: unavailable; routes and DNS still checked.")
            continue
        same = before[key] == after[key]
        print(f"{key}: {'unchanged' if same else 'CHANGED'}")
        unchanged &= same
    if not unchanged:
        print(f"Baseline saved at {BASELINE}; inspect changes before using the forward.")
    return 0 if unchanged else 1


def browser_login(url):
    parsed = urlsplit(url)
    if parsed.scheme != "https" or not (parsed.hostname or "").endswith(".ucla.edu"):
        print("Refusing an unexpected browser-login URL.", file=sys.stderr)
        return 1
    build_login()
    (STATE / "login-request.json").write_text(json.dumps({"id": str(uuid.uuid4()), "url": url}) + "\n")
    launcher = Path.home() / ".local/bin/cua-bg-launch"
    driver = Path.home() / ".local/bin/cua-driver"
    session = f"seasnet-login-{uuid.uuid4().hex[:10]}"
    subprocess.run([str(driver), "start_session", json.dumps({"session": session, "capture_scope": "window"})],
                   check=True, capture_output=True, timeout=15)
    try:
        result = subprocess.run([str(launcher), "SEASnet VPN Login"], capture_output=True, text=True, timeout=90)
    finally:
        subprocess.run([str(driver), "end_session", json.dumps({"session": session})], capture_output=True, timeout=15)
    if result.returncode not in (0, 2):
        write_login_result("failed")
        print("The login window could not be opened safely. Check the diagnostic log and retry.",
              file=sys.stderr, flush=True)
        return 1
    elif result.returncode == 2:
        print("The login window started, but background placement could not be verified. Choose SEASnet VPN Login manually.",
              file=sys.stderr, flush=True)
    else:
        print("UCLA login opened in SEASnet VPN Login. Choose its window to complete Duo.",
              file=sys.stderr, flush=True)
    return 0


def start(username=None, terminal_auth=False):
    pid = owned_pid()
    if pid:
        if listener_ready():
            touch_activity()
            ensure_idle_watch()
            print(f"Already connected: 127.0.0.1:{PORT} -> {TARGET}:22 (PID {pid}).")
            return 0
        print("VPN process exists but its forward is unavailable. Run seasnet-vpn stop first.", file=sys.stderr)
        return 1
    if terminal_auth and not sys.stdin.isatty():
        print("Start in your terminal for private UCLA login and Duo: seasnet-vpn start", file=sys.stderr)
        return 1
    with socket.socket() as check:
        try:
            check.bind(("127.0.0.1", PORT))
        except OSError:
            print(f"Port {PORT} is already occupied; refusing to reuse it.", file=sys.stderr)
            return 1
    BASELINE.write_text(json.dumps(snapshot(), indent=2) + "\n")
    PIDFILE.unlink(missing_ok=True)
    (STATE / "login-request.json").unlink(missing_ok=True)
    (STATE / "login-result.json").unlink(missing_ok=True)
    args = [OPENCONNECT, "--protocol=anyconnect", "--disable-ipv6",
            "--script-tun", "--script", f"{OCPROXY} -L {PORT}:{TARGET}:22 -k 30",
            "--background", "--pid-file", str(PIDFILE), "--reconnect-timeout=60"]
    if terminal_auth:
        args.append("--no-external-auth")
    else:
        args.extend(["--external-browser", str(Path(__file__).resolve())])
    if username:
        args.extend(["--user", username])
    args.append("https://ssl.vpn.ucla.edu")
    if terminal_auth:
        print("Enter your UCLA Logon credentials and Duo response as required by UCLA.", flush=True)
    else:
        print("Opening UCLA login; complete sign-in and Duo in SEASnet VPN Login.", flush=True)
    # The daemon must not retain an SSH caller's stdout/stderr pipes after
    # login. Browser authentication and subsequent VPN logs stay in this file.
    log = None if terminal_auth else (STATE / "openconnect.log").open("w")
    try:
        auth = subprocess.Popen(args, stdin=None if terminal_auth else subprocess.DEVNULL,
                                stdout=log or sys.stderr, stderr=log or sys.stderr)
    finally:
        if log is not None:
            log.close()
    deadline = time.monotonic() + LOGIN_TIMEOUT
    try:
        while auth.poll() is None:
            if login_cancelled() or time.monotonic() >= deadline:
                print("UCLA login cancelled or timed out.", file=sys.stderr)
                auth.terminate()
                auth.wait(timeout=10)
                write_login_result("failed")
                return 1
            time.sleep(0.2)
    except BaseException:
        if auth.poll() is None:
            auth.terminate()
            auth.wait(timeout=10)
        write_login_result("failed")
        raise
    if auth.returncode:
        write_login_result("failed")
        print(f"VPN login failed. Diagnostic log: {STATE / 'openconnect.log'}", file=sys.stderr)
        return auth.returncode
    for _ in range(20):
        pid = owned_pid()
        if pid and listener_ready():
            print(f"Connected: 127.0.0.1:{PORT} -> {TARGET}:22 (PID {pid}).", flush=True)
            result = verify()
            if result:
                print("Network comparison failed; stopping this VPN session.", file=sys.stderr)
                stop()
            else:
                touch_activity()
                ensure_idle_watch()
            write_login_result("failed" if result else "connected")
            return result
        time.sleep(0.2)
    print("VPN started but the restricted forward is unavailable; stopping it.", file=sys.stderr)
    stop()
    write_login_result("failed")
    return 1


def stop():
    pid = owned_pid()
    if not pid:
        print("No owned seasnet VPN process is running.")
        return 0
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if not owned_pid():
            PIDFILE.unlink(missing_ok=True)
            print("Disconnected.")
            return 0
        time.sleep(0.2)
    print("Shutdown is still in progress; inspect seasnet-vpn status.", file=sys.stderr)
    return 1


def proxy(host, port):
    if host != TARGET or port != "22":
        print("This forward only accepts cs35l.seas.ucla.edu:22.", file=sys.stderr)
        return 1
    def interrupted(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    leases = STATE / "connections"
    leases.mkdir(exist_ok=True, mode=0o700)
    path = leases / str(os.getpid())
    with control_lock(wait=True), redirect_stdout(sys.stderr):
        if not owned_pid() or not listener_ready():
            if owned_pid():
                stop()
            if start():
                return 1
        lease = path.open("w")
        fcntl.flock(lease, fcntl.LOCK_EX)
        touch_activity()
        ensure_idle_watch()
    client = None
    try:
        client = subprocess.Popen(["/usr/bin/nc", "127.0.0.1", str(PORT)])
        return client.wait()
    finally:
        if client is not None and client.poll() is None:
            client.terminate()
            client.wait(timeout=5)
        touch_activity()
        path.unlink(missing_ok=True)
        lease.close()


def main():
    os.umask(0o077)
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    if len(sys.argv) < 2:
        print("Usage: seasnet-vpn {start [--terminal] [UCLA_LOGON]|stop|status|verify|proxy HOST PORT|build-login}")
        return 2
    command = sys.argv[1]
    if command.startswith("https://") and len(sys.argv) == 2:
        return browser_login(command)
    if command == "browser-login" and len(sys.argv) == 3:
        return browser_login(sys.argv[2])
    if command == "proxy" and len(sys.argv) == 4:
        return proxy(*sys.argv[2:])
    if command == "status" and len(sys.argv) == 2:
        pid = owned_pid()
        ready = bool(pid and listener_ready())
        print(f"{'Connected' if ready else 'Disconnected'}: restricted forward to {TARGET}:22; idle timeout 15 minutes.")
        return 0 if ready else 1
    if command == "idle" and len(sys.argv) == 2:
        return idle_watch()
    if command == "build-login" and len(sys.argv) == 2:
        build_login()
        return 0
    if command == "verify" and len(sys.argv) == 2:
        return verify()
    remaining = sys.argv[2:]
    terminal_auth = "--terminal" in remaining
    if terminal_auth:
        remaining.remove("--terminal")
    if (command == "start" and len(remaining) <= 1
            or command == "stop" and not remaining and not terminal_auth):
        with control_lock():
            return start(remaining[0] if remaining else None, terminal_auth) if command == "start" else stop()
    print("Unknown command or invalid arguments.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
