#!/usr/bin/env python3
"""abby-guard: a local pass-through in front of api.abliteration.ai for abby.

Why (measured 2026-11-09 through a logging proxy, replaying a real request):
abliteration's gateway sometimes returns a response with NO content blocks
while billing output tokens (e.g. 68). The model did answer -- the same
request at effort "high" or with thinking off came back as a normal tool call
-- but at effort "max" the gateway swallowed it, 4 of 4 replays. Claude Code
sees an empty reply ("no visible output"), and since the context is unchanged
every retry is swallowed the same way, so a session gets stuck.

Streamed retries were swallowed too (even at high / thinking off); only
non-streamed requests at a lower effort came back intact.

What it does: forwards everything untouched. For POST /v1/messages it holds
back the stream's opening events until the first content block starts; if the
message ends with no content block but output tokens were billed, it re-sends
the request NON-streamed one effort step lower (max -> high -> thinking off)
and replays that answer to Claude Code as a stream. Nothing has reached
Claude Code by then, so the retry is invisible to it. Non-streamed requests
get the same ladder. Retries are logged (no content) to
~/.claude-abby/guard.log.

Run by launchd (com.mackhaymond.abby-guard, installed by abby) on
127.0.0.1:PORT; abby points ANTHROPIC_BASE_URL here when it is up.
"""
import http.client
import http.server
import json
import os
import socketserver
import ssl
import sys
import time
import urllib.parse

_up = urllib.parse.urlsplit(os.environ.get("ABBY_GUARD_UPSTREAM", "https://api.abliteration.ai"))
PORT = int(os.environ.get("ABBY_GUARD_PORT", "8789"))
LOG = os.path.expanduser("~/.claude-abby/guard.log")
TIMEOUT = 900  # seconds per upstream read; GLM at max effort can think for minutes
DROP_REQ = {"host", "content-length", "accept-encoding", "connection"}
DROP_RESP = {"transfer-encoding", "content-length", "connection", "content-encoding"}
CTX = ssl.create_default_context()


def log(**rec):
    rec["t"] = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(LOG, "a") as f:
            f.write(json.dumps(rec) + "\n")
    except OSError:
        pass


def step_down(body):
    """The same request one effort step lower, or None at the bottom."""
    oc = dict(body.get("output_config") or {})
    th = body.get("thinking") or {}
    if oc.get("effort") in ("max", "xhigh"):
        oc["effort"] = "high"
        return {**body, "output_config": oc}
    if th.get("type") not in (None, "disabled"):
        nb = {**body, "thinking": {"type": "disabled"}}
        oc.pop("effort", None)
        if oc:
            nb["output_config"] = oc
        else:
            nb.pop("output_config", None)
        return nb
    return None


def swallowed(usage, saw_block):
    return not saw_block and (usage or {}).get("output_tokens", 0) > 0


def visible(content):
    return [b for b in content or [] if b.get("type") != "text" or b.get("text")]


def sse(kind, data):
    return f"event: {kind}\ndata: {json.dumps(data)}\n\n".encode()


def as_stream(msg):
    """A non-streamed Messages response as the SSE events a stream would send."""
    usage = msg.get("usage") or {}
    head = {**msg, "content": [], "stop_reason": None, "stop_sequence": None,
            "usage": {**usage, "output_tokens": 0}}
    out = [sse("message_start", {"type": "message_start", "message": head})]
    for i, b in enumerate(visible(msg.get("content"))):
        t = b.get("type")
        if t == "text":
            start, deltas = {**b, "text": ""}, [{"type": "text_delta", "text": b["text"]}]
        elif t == "thinking":
            start = {**b, "thinking": "", "signature": ""}
            deltas = [{"type": "thinking_delta", "thinking": b.get("thinking", "")}]
            if b.get("signature"):
                deltas.append({"type": "signature_delta", "signature": b["signature"]})
        elif t in ("tool_use", "server_tool_use"):
            start = {**b, "input": {}}
            deltas = [{"type": "input_json_delta", "partial_json": json.dumps(b.get("input") or {})}]
        else:
            start, deltas = b, []
        out.append(sse("content_block_start",
                       {"type": "content_block_start", "index": i, "content_block": start}))
        out += [sse("content_block_delta", {"type": "content_block_delta", "index": i, "delta": d})
                for d in deltas]
        out.append(sse("content_block_stop", {"type": "content_block_stop", "index": i}))
    out.append(sse("message_delta", {"type": "message_delta", "usage": usage, "delta": {
        "stop_reason": msg.get("stop_reason"), "stop_sequence": msg.get("stop_sequence")}}))
    out.append(sse("message_stop", {"type": "message_stop"}))
    return out


def label(req):
    return (req.get("output_config") or {}).get("effort") or (req.get("thinking") or {}).get("type")


def read_event(resp):
    """One SSE event as (raw bytes, parsed data or None); (b"", None) at EOF."""
    raw = b""
    data = None
    while True:
        line = resp.readline()
        if not line:
            return raw, data
        raw += line
        if line.startswith(b"data:"):
            try:
                data = json.loads(line[5:])
            except ValueError:
                pass
        if line in (b"\n", b"\r\n"):
            return raw, data


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"

    def log_message(self, *a):
        pass

    def upstream(self, method, body):
        if _up.scheme == "https":
            conn = http.client.HTTPSConnection(_up.netloc, timeout=TIMEOUT, context=CTX)
        else:  # a local mock, for testing
            conn = http.client.HTTPConnection(_up.netloc, timeout=TIMEOUT)
        hdrs = {k: v for k, v in self.headers.items() if k.lower() not in DROP_REQ}
        if body is not None:
            hdrs["Content-Length"] = str(len(body))
        conn.request(method, self.path, body=body, headers=hdrs)
        return conn, conn.getresponse()

    def start(self, resp):
        self.send_response(resp.status)
        for k, v in resp.getheaders():
            if k.lower() not in DROP_RESP:
                self.send_header(k, v)
        self.send_header("Connection", "close")
        self.end_headers()

    def passthrough(self, method, body):
        conn, resp = self.upstream(method, body)
        try:
            self.start(resp)
            while chunk := resp.read(65536):
                self.wfile.write(chunk)
        finally:
            conn.close()

    def do_GET(self):
        self.passthrough("GET", None)

    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        path = self.path.split("?")[0]
        if path != "/v1/messages":
            return self.passthrough("POST", body)
        try:
            req = json.loads(body)
        except ValueError:
            return self.passthrough("POST", body)
        if req.get("stream"):
            self.stream(req, body)
        else:
            self.single(req, body)

    def retry(self, req, usage, stream):
        """Re-ask non-streamed, one effort step lower each time (at most two).
        Returns (resp, message) for the first answer with content, or None."""
        log(event="swallowed", stream=stream, model=req.get("model"), effort=label(req), usage=usage)
        for _ in range(2):
            req = step_down(req)
            if req is None:
                break
            req = {**req, "stream": False}
            conn, resp = self.upstream("POST", json.dumps(req).encode())
            try:
                data = resp.read()
            finally:
                conn.close()
            try:
                msg = json.loads(data) if resp.status == 200 else None
            except ValueError:
                msg = None
            if msg is None:
                log(event="retry-error", to=label(req), status=resp.status)
                return None
            if visible(msg.get("content")):
                log(event="recovered", to=label(req), stop=msg.get("stop_reason"),
                    blocks=[b.get("type") for b in visible(msg.get("content"))])
                return resp, msg
            log(event="retry-empty", to=label(req), usage=msg.get("usage"))
        return None

    def single(self, req, body):
        conn, resp = self.upstream("POST", body)
        try:
            data = resp.read()
        finally:
            conn.close()
        try:
            msg = json.loads(data) if resp.status == 200 else None
        except ValueError:
            msg = None
        if msg is not None and swallowed(msg.get("usage"), bool(visible(msg.get("content")))):
            got = self.retry(req, msg.get("usage"), stream=False)
            if got:
                resp, msg = got
                data = json.dumps(msg).encode()
        self.start(resp)
        self.wfile.write(data)

    def stream(self, req, body):
        conn, resp = self.upstream("POST", body)
        try:
            if resp.status != 200:
                self.start(resp)
                self.wfile.write(resp.read())
                return
            held, usage = [], None
            while True:
                raw, ev = read_event(resp)
                if not raw:
                    break
                kind = (ev or {}).get("type")
                if kind == "content_block_start":
                    # Content is flowing: from here on, a plain pass-through.
                    self.start(resp)
                    for h in held + [raw]:
                        self.wfile.write(h)
                    self.wfile.flush()
                    while True:
                        raw, _ = read_event(resp)
                        if not raw:
                            return
                        self.wfile.write(raw)
                        self.wfile.flush()
                held.append(raw)
                if kind == "message_delta":
                    usage = ev.get("usage")
                if kind == "message_stop":
                    break
            # The message ended with no content block at all.
            got = self.retry(req, usage, stream=True) if swallowed(usage, False) else None
            self.start(resp)
            for h in (as_stream(got[1]) if got else held):
                self.wfile.write(h)
            self.wfile.flush()
        finally:
            conn.close()


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    try:
        Server(("127.0.0.1", PORT), Handler).serve_forever()
    except OSError as e:  # port taken: another guard already serves it
        print(f"abby-guard: {e}", file=sys.stderr)
        sys.exit(1)
